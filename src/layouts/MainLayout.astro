---
import {
  siteMeta,
  socialLinks,
} from "../data/site";
import "../styles/global.css";
import "../styles/home-v3-tokens.css";
import "../styles/legacy-theme.css";
import SitePatterns from "../components/common/SitePatterns.astro";
import SiteHeader from "../components/HomeV3/SiteHeader.astro";
import SiteFooter from "../components/HomeV3/SiteFooter.astro";

type SchemaType = "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";

type ArticleMetadata = {
  headline: string;
  author: string;
  datePublished: string;
  dateModified?: string;
  image?: string;
};

interface Props {
  title?: string;
  desc?: string;
  metaImage?: string;
  /** A generated 1200 x 630 card in public/og/ (scripts/generate-og-images.mjs), e.g. "store". Defaults to "default". */
  socialCard?: string;
  metaImageAlt?: string;
  metaImageWidth?: number;
  metaImageHeight?: number;
  canonicalPath?: string;
  noindex?: boolean;
  footerClass?: string;
  schemaType?: SchemaType;
  article?: ArticleMetadata;
  showChrome?: boolean;
  bodyClass?: string;
  headerActionHref?: string;
  headerActionLabel?: string;
}

const {
  title = siteMeta.title,
  desc = siteMeta.description,
  metaImage,
  socialCard = "default",
  metaImageAlt = siteMeta.defaultSocialImageAlt,
  metaImageWidth,
  metaImageHeight,
  canonicalPath,
  noindex = false,
  schemaType = "WebPage",
  article,
  showChrome = true,
  bodyClass = "",
  headerActionHref = "/store",
  headerActionLabel = "Become a member",
} = Astro.props as Props;

const site = Astro.site ?? new URL(siteMeta.url);
const rawPath = canonicalPath ?? Astro.url.pathname;
const routePath = rawPath.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const normalizedPath = routePath === "/" ? "/" : routePath.replace(/\/+$/, "");
const canonicalUrl = new URL(normalizedPath, site).toString();

const socialImageUrl = new URL(metaImage || `/og/${socialCard}.jpg`, site).toString();
const socialImageWidth = metaImageWidth ?? (metaImage ? undefined : 1200);
const socialImageHeight = metaImageHeight ?? (metaImage ? undefined : 630);

const organizationId = new URL("/#organization", site).toString();
const websiteId = new URL("/#website", site).toString();
const webpageId = `${canonicalUrl}#webpage`;

const organizationSchema = {
  "@type": "Organization",
  "@id": organizationId,
  name: siteMeta.organizationName,
  legalName: siteMeta.legalName,
  url: siteMeta.url,
  logo: new URL("/svg/Logo-new.svg", site).toString(),
  sameAs: [socialLinks.linkedin, socialLinks.instagram, socialLinks.facebook, socialLinks.youtube],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  url: siteMeta.url,
  name: siteMeta.organizationName,
  description: siteMeta.description,
  publisher: { "@id": organizationId },
  inLanguage: "en-IN",
};

const pageSchema = {
  "@type": schemaType,
  "@id": webpageId,
  url: canonicalUrl,
  name: title,
  description: desc,
  isPartOf: { "@id": websiteId },
  about: { "@id": organizationId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: socialImageUrl,
  },
  inLanguage: "en-IN",
};

const segmentLabels: Record<string, string> = {
  blogs: "Blog",
  "about-us": "About Us",
  app: "App",
  contact: "Contact Us",
  device: "EyEagle",
  protection: "Protection",
  membership: "Membership",
  shipping: "Shipping Policy",
  refund: "Refund Policy",
  privacy: "Privacy Policy",
  tnc: "Terms of Service",
};
const segments = normalizedPath.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: new URL("/", site).toString(),
  },
  ...segments.map((segment, index) => {
    const isLast = index === segments.length - 1;
    const pathToSegment = `/${segments.slice(0, index + 1).join("/")}`;
    const name = isLast
      ? title.replace(/\s*[|–-]\s*EyEagle.*$/i, "").trim()
      : (segmentLabels[segment] ?? segment.replaceAll("-", " "));
    return {
      "@type": "ListItem",
      position: index + 2,
      name,
      item: new URL(segment === "blogs" ? "/blog" : pathToSegment, site).toString(),
    };
  }),
];

const graph: Record<string, unknown>[] = [organizationSchema, websiteSchema, pageSchema];
if (segments.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbItems,
  });
}
if (article) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    headline: article.headline,
    mainEntityOfPage: { "@id": webpageId },
    url: canonicalUrl,
    image: article.image || socialImageUrl,
    author: { "@type": "Person", name: article.author },
    publisher: { "@id": organizationId },
    datePublished: article.datePublished,
    ...(article.dateModified ? { dateModified: article.dateModified } : {}),
    inLanguage: "en-IN",
  });
}
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? "noindex, nofollow, noarchive" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageUrl.endsWith(".png") ? "image/png" : "image/jpeg"} />
    {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
    {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
    <meta property="og:image:alt" content={metaImageAlt} />
    <meta property="og:site_name" content={siteMeta.organizationName} />
    <meta property="og:locale" content="en_IN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={metaImageAlt} />

    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/faculty-glyphic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/FavIcon.png" type="image/png" />
    <script type="application/ld+json" is:inline set:html={structuredData}></script>

    <script type="text/partytown" is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteMeta.gtmId}`}></script>
    <script type="text/partytown" is:inline define:vars={{ gtmId: siteMeta.gtmId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", gtmId);
    </script>
  </head>

  <body class:list={["min-h-screen bg-[var(--color-surface)] text-gray-900 antialiased eyeagle-home-v3", bodyClass]}>
    <a href="#main-content" class="sr-only z-100 rounded bg-[var(--color-surface)] px-4 py-3 text-black focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to main content</a>

    <slot name="header" />
    {showChrome && <SiteHeader solidAtTop actionHref={headerActionHref} actionLabel={headerActionLabel} variant="figmaHome" />}
    {showChrome ? <main id="main-content" class="legacy-content"><slot /></main> : <slot />}
    {showChrome && <SiteFooter />}
    <slot name="footer" />
    <SitePatterns />

    <script is:inline>
      const menuButton = document.querySelector("[data-menu-toggle]");
      const mobileMenu = document.querySelector("[data-mobile-menu]");
      const openIcon = document.querySelector("[data-menu-open-icon]");
      const closeIcon = document.querySelector("[data-menu-close-icon]");

      const setMenuOpen = (open) => {
        if (!menuButton || !mobileMenu) return;
        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
        mobileMenu.hidden = !open;
        openIcon?.classList.toggle("hidden", open);
        closeIcon?.classList.toggle("hidden", !open);
        document.body.classList.toggle("overflow-hidden", open);
      };

      menuButton?.addEventListener("click", () => setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true"));
      mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setMenuOpen(false);
          document.querySelectorAll("[data-desktop-dropdown][open]").forEach((details) => details.removeAttribute("open"));
        }
      });
      document.addEventListener("click", (event) => {
        document.querySelectorAll("[data-desktop-dropdown][open]").forEach((details) => {
          if (!details.contains(event.target)) details.removeAttribute("open");
        });
      });
      window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024) setMenuOpen(false);
      }, { passive: true });
    </script>

  </body>
</html>

<style is:global>
  :root {
    --type-display-family: "Faculty Glyphic", "Geist", Arial, sans-serif;
    --type-body-family: "Geist", Arial, sans-serif;
    --type-font-family: var(--type-body-family);
    --type-weight-regular: 400; --type-weight-medium: 500;
    --type-display-size: clamp(38px, 3.4vw, 48px); --type-display-line: clamp(43px, 3.9vw, 55px);
    --type-h1-size: clamp(36px, 2.9vw, 42px); --type-h1-line: clamp(42px, 3.45vw, 50px);
    --type-h2-size: clamp(28px, 2.25vw, 34px); --type-h2-line: clamp(35px, 2.85vw, 41px); --type-h3-size: clamp(22px, 1.667vw, 24px); --type-h3-line: 28px;
    --type-h4-size: 18px; --type-h4-line: 24px; --type-body-xl-size: clamp(18px, 1.389vw, 20px); --type-body-xl-line: 26px;
    --type-body-md-size: 16px; --type-body-md-line: 24px; --type-body-sm-size: 16px; --type-body-sm-line: 24px;
    --type-body-xs-size: 14px; --type-body-xs-line: 20px;
    --space-page-x: clamp(20px, 4vw, 56px); --space-section-y: clamp(96px, 7.6vw, 112px); --space-section-y-compact: clamp(72px, 6vw, 96px);
    --content-max: 1180px; --reading-max: 640px;
    --motion-duration-enter: 820ms; --motion-duration-reveal: 520ms; --motion-duration-ui: 180ms;
    --motion-ease-enter: cubic-bezier(0.16, 1, 0.3, 1); --motion-ease-standard: cubic-bezier(0.2, 0, 0, 1); --motion-ease-exit: cubic-bezier(0.4, 0, 1, 1);
    --color-surface: #ffffff; --color-surface-muted: #f3f3f1; --color-surface-soft: #f7f7f4; --color-surface-dark: #000000; --color-surface-dark-soft: #111111;
    --color-text: #0a0a0a; --color-text-muted: #6f6f6b; --color-text-soft: #62625e; --color-text-on-dark: #ffffff; --color-text-on-dark-muted: rgba(255,255,255,.72);
    --color-line: #e5e5e2; --color-action: #d11f2b; --color-action-hover: #b91b25; --color-on-action: #ffffff; --color-focus: #315efb;
  }
  html { scroll-behavior: smooth; }
  body { min-height: 100%; overflow-x: hidden; background: var(--color-surface); color: var(--color-text); font-family: var(--type-font-family); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
  [hidden] { display: none !important; }
  summary::-webkit-details-marker { display: none; }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  ::selection { background: var(--color-action); color: var(--color-on-action); }
  article img { border-radius: 16px; }
  .prose ul ul { list-style-type: circle; }
  .prose blockquote { margin: 2rem 0; border: 0; border-radius: 16px; background: #fbebeb; padding: 1.5rem; color: #262626; font-style: normal; }
  .prose blockquote p { margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.75; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>

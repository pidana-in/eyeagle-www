---
import Image from "../common/OptimizedImage.astro";
import MaterialIcon from "../common/MaterialIcon.astro";
import { scrollDataSection } from "../constants/home";

const item = Astro.props.item;
const { pathname } = Astro.url;
---

<div
  class="relative bg-[#D9D9D9] rounded-[20px] flex flex-col cursor-pointer group lg:max-w-74 lg:max-h-100 h-auto max-w-60"
  id={`card-${item.id}`}
>
  <h2
    class="text-[19.2px] lg:text-[32px] leading-6 font-sans-instrument font-medium lg:leading-10 px-5 py-[14.4px] lg:py-6 lg:px-10 text-[#212121]"
  >
    {item.heading.split(" ")[0]}<br />
    {item.heading.split(" ").slice(1).join(" ")}
  </h2>
  <Image
    src={item.image ?? ""}
    alt={item.heading}
    class="w-full h-full object-cover rounded-[20px] rounded-t-none"
    quality="max"
  />

  <!-- Optional: Keep the icon for visual cue -->
  <div
    class="absolute lg:bottom-[13.5px] lg:right-[16.5px] bottom-[8.5px] right-2.5 z-30 bg-white lg:size-10 size-7 rounded-full grid place-items-center pointer-events-none"
  >
    <MaterialIcon name="arrow_forward" classNames="w-2.25 h-2.25 lg:w-4 lg:h-4 text-primary" />
  </div>
</div>

<script is:inline define:vars={{ item, scrollDataSection, pathname }}>
  const card = document.getElementById(`card-${item.id}`);

  function scrollFunction() {
    const targetId = scrollDataSection[item.id];
    const element = document.getElementById(targetId);
    if (element) {
      element.scrollIntoView({ behavior: "smooth" });
    }
  }

  if (card) {
    if (pathname === "/join") {
      card.addEventListener("click", (e) => {
        e.preventDefault(); // stop any default navigation
        const targetId = scrollDataSection[item.id];
        window.open(`/#${targetId}`, "_blank"); // open in new tab only
      });
    } else {
      card.addEventListener("click", (e) => {
        e.preventDefault(); // optional if wrapped in <a>
        scrollFunction();
      });
    }
  }
</script>

---
type ComparisonRow = {
  label: string;
  noKit: string;
  oneBar: string;
  planned: string;
};

const comparisonRows = Astro.props.comparisonRows as ComparisonRow[];
const comparisonColumns = Astro.props.comparisonColumns;
const comparisonData = Astro.props.comparisonData;
---

<section id="comparison-section" class="my-20 2xl:container">
  <div class="px-4 md:px-40 text-center md:mb-25 mb-20">
    <h2 class="protection-section-title">
      {comparisonData.title}
    </h2>
    <p class="protection-section-intro mt-5">
      {comparisonData.desc}
    </p>
  </div>
  <div class="xl:hidden px-4 space-y-4">
    {
      comparisonRows.map((row: ComparisonRow) => (
        <details class="protection-comparison-card group overflow-hidden">
          <summary class="protection-body-lg flex justify-between items-center p-4 font-semibold cursor-pointer list-none">
            {row.label}
            <svg
              class="w-5 h-5 transition-transform duration-300 group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </summary>
          <div class="protection-caption">
            <div class="protection-comparison-row grid grid-cols-[110px_1fr] gap-5 px-4 py-4">
              <span class="protection-subtle">{comparisonColumns[1]}</span>
              <span>{row.noKit}</span>
            </div>

            <div class="protection-comparison-row grid grid-cols-[110px_1fr] gap-5 px-4 py-4">
              <span class="protection-subtle">{comparisonColumns[2]}</span>
              <span>{row.oneBar}</span>
            </div>
            <div class="protection-comparison-highlight grid grid-cols-[110px_1fr] gap-5 px-4 py-4">
              <span>{comparisonColumns[3]}</span>
              <span>{row.planned}</span>
            </div>
          </div>
        </details>
      ))
    }
  </div>
  <div class="hidden xl:block">
    <div
      class="px-4 xl:px-10 overflow-x-auto scrollbar-hide"
    >
      <div class="protection-body-lg min-w-275">
        <div class="protection-comparison-rule grid grid-cols-[1.2fr_1.6fr_1.8fr_280px]">
          <div class="font-semibold py-4 pr-8">{comparisonColumns[0]}</div>
          <div class="font-semibold py-4 pr-8">{comparisonColumns[1]}</div>
          <div class="font-semibold py-4 pr-8">{comparisonColumns[2]}</div>
          <div
            class="protection-comparison-highlight protection-comparison-highlight-top font-semibold py-4 px-4"
          >
            {comparisonColumns[3]}
          </div>
        </div>
        {
          comparisonRows.map((row: ComparisonRow, index: number) => (
            <div
              class={`grid grid-cols-[1.2fr_1.6fr_1.8fr_280px] ${
                index !== comparisonRows.length - 1 ? "protection-comparison-rule" : ""
              }`}
            >
              <div class="py-4 pr-8 font-semibold">{row.label}</div>
              <div class="py-4 pr-8">{row.noKit}</div>
              <div class="py-4 pr-8">{row.oneBar}</div>
              <div
                class={`protection-comparison-highlight py-4 px-4 ${
                  index === comparisonRows.length - 1 ? "protection-comparison-highlight-bottom" : ""
                }`}
              >
                {row.planned}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

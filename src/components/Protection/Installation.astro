---
import Image from "../common/OptimizedImage.astro";

type InstallStep = {
  title: string;
  description: string;
};

type FeatureItem = {
  title: string;
  desc: string;
};

const installSteps = Astro.props.installSteps;
const installCards = Astro.props.installCards as InstallStep[];
const installFeatures = Astro.props.installFeatures as FeatureItem[];
const installImages = Astro.props.installImages;
---

<section class="2xl:container py-12 lg:py-20">
  <div class="flex flex-col lg:flex-row gap-20 justify-center px-4">
    <!-- LEFT -->
    <div class="lg:sticky lg:top-32 lg:self-start max-w-115 py-6">
      <h2 class="protection-section-title">
        {installSteps.title}
      </h2>
    </div>

    <!-- RIGHT -->
    <div class="flex flex-col gap-16 lg:max-w-135">
      {
        installCards.map((card, i) => (
          <div>
            <Image
              src={installImages[i]}
              alt={card.title}
              class="protection-media w-full"
            />

            <div class="mt-10">
              <h3 class="protection-card-title">{card.title}</h3>
              <p class="protection-body protection-muted mt-2">{card.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
<!-- FEATURES -->
<div class="2xl:container mt-10 md:my-25 flex justify-center px-4 md:px-30">
  <div
    class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-5 text-center max-w-full"
  >
    {
      installFeatures.map((item: FeatureItem) => (
        <div class="protection-stat-item max-w-full md:max-w-67.5 px-2 mx-auto">
          <p class="protection-stat protection-accent font-semibold">
            {item.title}
          </p>
          <p class="protection-caption protection-muted mt-2">{item.desc}</p>
        </div>
      ))
    }
  </div>
</div>

---
import FAQSection from "../HomeV3/FAQSection.astro";

type FAQItem = {
  question: string;
  answer: string;
};

const faqsData = Astro.props.faqsData as FAQItem[];
---

<FAQSection
  description="Clear answers about the protection kit, planning and installation."
  eyebrow="Planning your bathroom"
  id="protection-faq"
  items={faqsData}
/>

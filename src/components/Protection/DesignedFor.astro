---
import Image from "../common/OptimizedImage.astro";
import type { ImageMetadata } from "astro";
import ContentImage from "../../assets/Protection/ContentImage.png";

type UserCard = {
  image: ImageMetadata;
  title: string;
  desc: string;
};

type StatItem = {
  value: string;
  label: string;
};

interface Props {
  userCards: UserCard[];
  statsData: StatItem[];
}
const { userCards, statsData } = Astro.props as Props;
---

<section class="2xl:container py-16 md:py-20 px-4 lg:px-30">
  <div class="flex flex-col items-center text-center">
    <div class="md:mx-30">
      <h2 class="protection-section-title">
        Designed around the people who use it.
      </h2>
      <p class="protection-section-intro mt-5">
        The layout is shaped around the person using the bathroom—their reach,
        balance, routine and the areas where they want more support.
      </p>
    </div>
  </div>
  <div
    class="mt-20 flex md:grid md:grid-cols-3 gap-6 md:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-hide"
  >
    {
      userCards.map((card: UserCard) => (
        <div class="shrink-0 w-[85%] sm:w-[70%] md:w-auto snap-center flex flex-col rounded-3xl border border-[#00000014] bg-[#F9F7F7] overflow-hidden text-center">
          <Image
            src={card.image}
            alt={card.title}
            class="w-full object-cover"
          />
          <div class="p-6">
            <h3 class="text-lg md:text-xl font-bold">{card.title}</h3>
            <p class="mt-3 text-base opacity-60">{card.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
  <div class="flex flex-col items-center text-center mt-30">
    <h2 class="protection-section-title">
      Safety you can feel, numbers you can trust.
    </h2>
    <div
      class="mt-8 md:mt-15 grid grid-cols-2 md:grid-cols-4 gap-5 md:gap-10"
    >
      {
        statsData.map((stat: StatItem) => (
          <div class="flex flex-col max-w-52 mx-auto">
            <h3 class="text-primary text-xl md:text-2xl font-bold">
              {stat.value}
            </h3>
            <p class="text-base opacity-60 mt-2">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <div class="flex justify-center mt-20">
      <Image
        src={ContentImage}
        alt="EyEagle wall grab bar and toilet support rail installed in a bathroom"
        class="w-full object-contain"
      />
    </div>
  </div>
</section>

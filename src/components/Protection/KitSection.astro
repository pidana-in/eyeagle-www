---
import type { ImageMetadata } from "astro";
import Image from "../common/OptimizedImage.astro";

type OverviewCard = {
  title: string;
  desc: string;
  image: ImageMetadata;
  textPosition: "top" | "bottom";
};

type FeatureItem = {
  title: string;
  desc: string;
};

const overviewCards = Astro.props.overviewCards;
const barFeatures = Astro.props.barFeatures;
const matFeatures = Astro.props.matFeatures;
const tapeFeatures = Astro.props.tapeFeatures;
const sectionHeaders = Astro.props.sectionHeaders;
const kitData = Astro.props.kitData;
---

<section id="Overview" class="py-10">
  <div class="2xl:container mx-auto px-3">
    <div class="text-center">
      <h2 class="protection-section-title">
        More than a single bar.<br />
        A complete bathroom protection kit.
      </h2>

      <p class="protection-section-intro mt-6 md:px-30">
        Instead of selling a single grab bar and leaving the rest to guesswork,
        we combine grab bars, floor grip and a planned layout into one system
        tailored to your bathroom and the people who use it.
      </p>
    </div>
    <div
      class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-10 max-w-240 mx-auto"
    >
      {
        overviewCards.map((card: OverviewCard) => (
          <div class="relative w-full">
            <Image
              src={card.image}
              alt={card.title}
              class="protection-media w-full object-cover"
            />
            <div
              class={`absolute left-6 right-6 ${
                card.textPosition === "bottom" ? "bottom-6" : "top-6"
              }`}
            >
              <h3 class="protection-card-title">{card.title}</h3>
              <p class="protection-body protection-muted mt-2">{card.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="protection-caption protection-subtle mt-12 text-center italic">
      We plan the quantity and placement with you, based on your bathroom and
      who uses it.
    </p>
  </div>
</section>
<section id="About Bars">
  <div
    class="xl:container mx-auto py-16 md:my-10 px-4 md:px-10 lg:px-16 xl:px-24"
  >
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-8 lg:gap-30 text-start"
    >
      <h2 class="protection-subsection-title">
        {sectionHeaders.bars.title}
      </h2>

      <p class="protection-section-intro max-w-xl mx-auto lg:mx-0">
        {sectionHeaders.bars.description}
      </p>
    </div>
    <div
      class="mt-10 md:mt-18 flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-0 text-center"
    >
      {
        barFeatures.map((f: FeatureItem, i: number) => (
          <>
            <div class="md:flex-1">
              <p class="protection-body-lg protection-accent font-bold">{f.title}</p>
              <p class="protection-body protection-muted my-2 max-w-60 mx-auto">
                {f.desc}
              </p>
            </div>
            {i !== barFeatures.length - 1 && (
              <>
                <div class="hidden md:flex items-center">
                  <div class="protection-accent-line w-px h-10" />
                </div>
                <div class="md:hidden flex justify-center">
                  <div class="protection-accent-line w-72 h-px" />
                </div>
              </>
            )}
          </>
        ))
      }
    </div>
  </div>
  <div class="protection-product-band py-16 md:py-20">
    <div
      class="2xl:container px-6 flex flex-col gap-12 lg:flex-row lg:items-center lg:justify-center lg:gap-20"
    >
      <Image
        src={kitData.img1}
        alt="Wall-mounted bathroom support stand from the EyEagle protection kit"
        class="w-full max-w-125 h-auto mx-auto object-contain"
      />
      <Image
        src={kitData.img2}
        alt="Bathroom support handle from the EyEagle protection kit"
        class="w-full max-w-125 h-auto mx-auto object-contain"
      />
    </div>
  </div>
  <section id="About Matte">
    <div class="protection-surface">
      <div
        class="xl:container mx-auto py-16 md:my-14 px-4 md:px-10 lg:px-16 xl:px-24"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-30 text-start"
        >
          <h2 class="protection-subsection-title">
            {sectionHeaders.mat.title}
          </h2>

          <p class="protection-section-intro max-w-xl mx-auto lg:mx-0">
            {sectionHeaders.mat.description}
          </p>
        </div>
        <div
          class="mt-10 md:mt-18 flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-0 text-center"
        >
          {
            matFeatures.map((f: FeatureItem, i: number) => (
              <>
                <div class="md:px-4">
                  <p class="protection-body-lg protection-accent font-bold">{f.title}</p>
                  <p class="protection-body protection-muted my-2">
                    {f.desc}
                  </p>
                </div>
                {i !== matFeatures.length - 1 && (
                  <>
                    <div class="hidden md:flex items-center">
                      <div class="protection-accent-line w-px h-10" />
                    </div>
                    <div class="md:hidden flex justify-center">
                      <div class="protection-accent-line w-72 h-px" />
                    </div>
                  </>
                )}
              </>
            ))
          }
        </div>
      </div>
    </div>
    <div class="protection-soft-band flex justify-center py-12 md:py-20 px-4">
      <Image
        src={kitData.img3}
        alt="Anti-slip bathroom mat with a draining slatted surface"
        class="w-full max-w-175 mx-auto object-contain"
      />
    </div>
  </section>
  <section id="About Tape">
    <div
      class="xl:container mx-auto py-16 md:mt-12 px-4 md:px-10 lg:px-16 xl:px-24"
    >
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-30 text-start"
      >
        <h2 class="protection-subsection-title">
          {sectionHeaders.tape.title}
        </h2>
        <p class="protection-section-intro max-w-xl mx-auto lg:mx-0">
          {sectionHeaders.tape.description}
        </p>
      </div>
      <div
        class="mt-10 md:mt-18 flex flex-col md:flex-row items-center md:items-stretch text-center gap-8 md:gap-10"
      >
        {
          tapeFeatures.map((f: FeatureItem, i: number) => (
            <>
              <div class="flex-1">
                <p class="protection-body-lg protection-accent font-bold">{f.title}</p>
                <p class="protection-body protection-muted my-2">
                  {f.desc}
                </p>
              </div>
              {i !== tapeFeatures.length - 1 && (
                <>
                  <div class="hidden md:flex items-center">
                    <div class="protection-accent-line w-px h-10" />
                  </div>
                  <div class="md:hidden flex justify-center">
                    <div class="protection-accent-line w-72 h-px" />
                  </div>
                </>
              )}
            </>
          ))
        }
      </div>
    </div>
  </section>
  <div class="md:py-20 py-10 2xl:container">
    <Image
      src={kitData.img4}
      alt="Bathroom floor"
      class="protection-wide-media w-full object-contain"
    />
  </div>
</section>

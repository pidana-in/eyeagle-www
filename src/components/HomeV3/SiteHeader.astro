---
import ButtonLink from "./ButtonLink.astro";
import SiteLogo from "./SiteLogo.astro";
import styles from "../../styles/HomeV3/site-header.module.css";

interface Props {
  solidAtTop?: boolean;
  actionHref?: string;
  actionLabel?: string;
  showAction?: boolean;
  showNavigation?: boolean;
}

const {
  solidAtTop = false,
  actionHref = "/store",
  actionLabel = "Get membership",
  showAction = true,
  showNavigation = true,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navigation = [
  { label: "How it works", href: "/solution" },
  { label: "Bathroom Protection", href: "/protection" },
  { label: "Our Story", href: "/about-us" },
  { label: "Blog", href: "/blog" },
] as const;

const isActive = (href: string) =>
  currentPath === href || (href === "/blog" && currentPath.startsWith("/blogs/"));
---

<header
  class={styles.header}
  data-fixed="true"
  data-hidden="false"
  data-menu-open="false"
  data-overlay="true"
  data-solid-at-top={String(solidAtTop)}
  data-auto-hide={String(showNavigation || showAction)}
  data-compact-action="true"
  data-home-v3-header
>
  <div class={styles.bar}>
    <a class={styles.brand} href="/" aria-label="EyEagle home">
      <span aria-hidden="true" class={styles.logoLayer} data-logo-light data-visible="true">
        <SiteLogo inverse />
      </span>
      <span aria-hidden="true" class={styles.logoLayer} data-logo-dark data-visible="false">
        <SiteLogo />
      </span>
    </a>

    {showNavigation && (
      <nav class={styles.desktopNav} aria-label="Primary navigation">
        {navigation.map((item) => (
          <a
            aria-current={isActive(item.href) ? "page" : undefined}
            class={styles.navLink}
            data-active={String(isActive(item.href))}
            href={item.href}
          >{item.label}</a>
        ))}
      </nav>
    )}

    {showAction && (
      <div class={styles.desktopAction}>
        <ButtonLink href={actionHref} size="small">{actionLabel}</ButtonLink>
      </div>
    )}

    {(showAction || showNavigation) && (
      <div class={styles.mobileActions}>
        {showAction && <ButtonLink href={actionHref} size="small">{actionLabel}</ButtonLink>}
        {showNavigation && (
          <button
            aria-controls="mobile-navigation"
            aria-expanded="false"
            aria-label="Open navigation"
            class={styles.menuButton}
            data-home-v3-menu-button
            type="button"
          >
            <span class={styles.menuLine}></span>
            <span class={styles.menuLine}></span>
          </button>
        )}
      </div>
    )}
  </div>

  {showNavigation && (
    <div
      aria-hidden="true"
      class={styles.mobileMenu}
      data-home-v3-mobile-menu
      data-open="false"
      id="mobile-navigation"
      inert
    >
      <nav class={styles.mobileNav} aria-label="Mobile navigation">
        {navigation.map((item, index) => (
          <a
            aria-current={isActive(item.href) ? "page" : undefined}
            class={styles.mobileLink}
            data-active={String(isActive(item.href))}
            data-mobile-nav-link
            href={item.href}
            style={`--link-index: ${index}`}
            tabindex="-1"
          >
            <span>{item.label}</span><span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>

      <div class={styles.mobileMenuFooter}>
        <p>Device, app and human response.</p>
        {showAction && <ButtonLink href={actionHref} size="large" tabindex={-1}>{actionLabel}</ButtonLink>}
      </div>
    </div>
  )}
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-home-v3-header]");
  const menuButton = header?.querySelector<HTMLButtonElement>("[data-home-v3-menu-button]");
  const mobileMenu = header?.querySelector<HTMLElement>("[data-home-v3-mobile-menu]");
  const lightLogo = header?.querySelector<HTMLElement>("[data-logo-light]");
  const darkLogo = header?.querySelector<HTMLElement>("[data-logo-dark]");
  const mobileLinks = Array.from(header?.querySelectorAll<HTMLElement>("[data-mobile-nav-link]") ?? []);
  const mobileMenuLinks = Array.from(mobileMenu?.querySelectorAll<HTMLElement>("a") ?? []);
  const solidAtTop = header?.dataset.solidAtTop === "true";
  const autoHide = header?.dataset.autoHide === "true";
  let menuOpen = false;
  let lastScrollY = Math.max(window.scrollY, 0);
  let frameId = 0;

  const setMenuOpen = (open: boolean) => {
    if (!header || !menuButton || !mobileMenu) return;
    menuOpen = open;
    header.dataset.menuOpen = String(open);
    header.dataset.hidden = "false";
    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    mobileMenu.dataset.open = String(open);
    mobileMenu.setAttribute("aria-hidden", String(!open));
    mobileMenu.toggleAttribute("inert", !open);
    document.body.dataset.menuOpen = String(open);
    document.querySelector("main")?.toggleAttribute("inert", open);
    document.querySelector("footer")?.toggleAttribute("inert", open);
    mobileMenuLinks.forEach((element) => element.setAttribute("tabindex", open ? "0" : "-1"));
    updateHeader();
    if (open) requestAnimationFrame(() => mobileLinks[0]?.focus());
    else menuButton.focus();
  };

  const updateHeader = () => {
    if (!header) return;
    const currentY = Math.max(window.scrollY, 0);
    const atTop = currentY < 32;
    const overlay = atTop && !solidAtTop;
    header.dataset.overlay = String(overlay);
    lightLogo?.setAttribute("data-visible", String(overlay && !menuOpen));
    darkLogo?.setAttribute("data-visible", String(!overlay || menuOpen));

    if (!autoHide || atTop || menuOpen) header.dataset.hidden = "false";
    else {
      const distance = currentY - lastScrollY;
      if (distance > 8) header.dataset.hidden = "true";
      if (distance < -8) header.dataset.hidden = "false";
    }
    if (Math.abs(currentY - lastScrollY) > 8 || atTop) lastScrollY = currentY;
  };

  menuButton?.addEventListener("click", () => setMenuOpen(!menuOpen));
  mobileLinks.forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
  window.addEventListener("scroll", () => {
    if (frameId) return;
    frameId = requestAnimationFrame(() => {
      updateHeader();
      frameId = 0;
    });
  }, { passive: true });
  header?.addEventListener("focusin", () => { if (header) header.dataset.hidden = "false"; });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuOpen) setMenuOpen(false);
    if (event.key !== "Tab" || !menuOpen || !header) return;
    const focusable = Array.from(header.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex="0"]'))
      .filter((element) => element.offsetParent !== null);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
  });
  updateHeader();
</script>

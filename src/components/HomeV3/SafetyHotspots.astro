---
import Image from "../common/OptimizedImage.astro";
import MaterialIcon from "../common/MaterialIcon.astro";
import photo from "../../assets/HomeV3/protection-latest.png";
const features = [
  { x: 82, y: 40, title: "Shower grab bar", what: "A fixed handhold beside the shower.", why: "Gives you support while standing or moving in the shower." },
  { x: 43, y: 41, title: "Toilet support rail", what: "A support rail alongside the toilet.", why: "Provides a handhold when sitting down and getting back up." },
  { x: 73, y: 80, title: "Shower mat", what: "A dedicated surface underfoot in the shower.", why: "A suitable slip-resistant mat can improve footing. Material, drainage and secure placement matter." },
];
---
<div class="safety-explorer" data-safety-explorer>
  <p class="explorer-hint">Explore the safety features <span>Hover, tap or focus a dot</span></p>
  <div class="safety-photo">
    <div class="safety-stage">
    <Image alt="A woman holding a shower grab bar, with a toilet support rail and shower mat also visible" layout="full-width" src={photo} />
    {features.map((feature, i) => <button class="safety-dot" style={`left:${feature.x}%;top:${feature.y}%`} type="button" aria-label={`Learn about the ${feature.title.toLowerCase()}`} aria-expanded="false" aria-controls="safety-feature-description" data-feature={i}><span aria-hidden="true"></span></button>)}
    </div>
    <div class="safety-description" id="safety-feature-description" hidden>
      <button class="safety-close" type="button" aria-label="Close feature description"><MaterialIcon name="close" /></button>
      <p class="safety-eyebrow">Bathroom safety</p>
      <h3 data-feature-title></h3>
      <p data-feature-what></p>
      <p class="safety-why"><strong>Why it helps</strong><span data-feature-why></span></p>
    </div>
  </div>
  <script is:inline type="application/json" data-safety-content set:html={JSON.stringify(features)} />
</div>
<style>
  .safety-explorer { width: min(1138px,100%); }
  .explorer-hint { display:flex; justify-content:space-between; gap:12px; margin-bottom:14px; font-size:13px; line-height:20px; }
  .explorer-hint span { color:var(--color-text-muted); }
  .safety-photo { position:relative; }
  .safety-stage { position:relative; }
  .safety-photo :global(img) { display:block; width:100%; height:auto; border-radius:14px; }
  .safety-dot { position:absolute; transform:translate(-50%,-50%); width:44px; height:44px; display:grid; place-items:center; border:0; padding:0; background:transparent; cursor:pointer; z-index:2; }
  .safety-dot span { width:15px; height:15px; border:3px solid white; border-radius:50%; background:var(--color-action); box-shadow:0 0 0 7px rgba(255,255,255,.3),0 2px 12px rgba(0,0,0,.25); transition:transform 180ms ease,box-shadow 180ms ease; }
  .safety-dot[aria-expanded=true] span,.safety-dot:hover span { transform:scale(1.15); box-shadow:0 0 0 9px rgba(255,255,255,.4); }
  .safety-dot:focus-visible,.safety-close:focus-visible { outline:2px solid var(--color-focus); outline-offset:3px; border-radius:50%; }
  .safety-description { position:absolute; left:4%; top:10%; width:31%; padding:24px; border:1px solid rgba(255,255,255,.25); border-radius:12px; background:rgba(22,23,22,.93); color:white; backdrop-filter:blur(12px); z-index:3; }
  .safety-description[hidden] { display:none; }
  .safety-eyebrow { font-size:11px; color:rgba(255,255,255,.6); margin-bottom:10px; }
  .safety-description h3 { font-size:20px; line-height:1.25; font-weight:400; margin-bottom:10px; }
  .safety-description p:not(.safety-eyebrow) { font-size:14px; line-height:21px; color:rgba(255,255,255,.8); }
  .safety-why { margin-top:18px; padding-top:16px; border-top:1px solid rgba(255,255,255,.2); }
  .safety-why strong { display:block; margin-bottom:5px; font-size:12px; font-weight:500; color:white; }
  .safety-close { position:absolute; top:8px; right:8px; width:28px; height:28px; display:grid; place-items:center; border:0; background:transparent; color:white; cursor:pointer; font-size:20px; }
  @media(max-width:760px) { .safety-description { position:relative; left:auto; top:auto; width:100%; margin-top:12px; padding:22px; } .explorer-hint { display:none; } .safety-dot { width:36px; height:36px; } .safety-dot span { width:12px; height:12px; border-width:2px; } }
  @media(prefers-reduced-motion:reduce) { .safety-dot span { transition:none; } }
</style>
<script>
  const explorer = document.querySelector<HTMLElement>("[data-safety-explorer]");
  if (explorer) {
    const features = JSON.parse(explorer.querySelector("[data-safety-content]")?.textContent ?? "[]") as {title:string;what:string;why:string}[];
    const dots = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[data-feature]"));
    const panel = explorer.querySelector<HTMLElement>(".safety-description")!;
    let active = -1;
    let dismissed = -1;
    const close = () => { dismissed = active; active = -1; panel.hidden = true; dots.forEach(dot => dot.setAttribute("aria-expanded","false")); };
    const show = (index:number) => {
      active = index;
      const feature = features[index];
      panel.querySelector("[data-feature-title]")!.textContent = feature.title;
      panel.querySelector("[data-feature-what]")!.textContent = feature.what;
      panel.querySelector("[data-feature-why]")!.textContent = feature.why;
      panel.hidden = false;
      dots.forEach((dot,i) => dot.setAttribute("aria-expanded",String(index === i)));
    };
    dots.forEach((dot,index) => {
      dot.addEventListener("pointerenter",event => { if(event.pointerType === "mouse") { dismissed = -1; show(index); } });
      dot.addEventListener("focus",() => { if(dismissed !== index) show(index); });
      dot.addEventListener("click",() => { dismissed = -1; show(index); });
    });
    explorer.querySelector(".safety-close")?.addEventListener("click",() => { const previous = active; close(); dots[previous]?.focus(); });
    document.addEventListener("pointerdown",event => { if(!explorer.contains(event.target as Node)) close(); });
    explorer.addEventListener("keydown",event => { if(event.key === "Escape") { const previous = active; close(); dots[previous]?.focus(); } });
    explorer.addEventListener("focusout",event => { if(!explorer.contains(event.relatedTarget as Node)) close(); });
  }
</script>

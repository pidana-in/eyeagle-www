---
import styles from "../../styles/HomeV3/button-link.module.css";

interface Props {
  href: string;
  size?: "large" | "small";
  variant?: "solid" | "inverse" | "glass";
  class?: string;
  tabindex?: number;
  target?: "_blank" | "_self" | "_parent" | "_top";
  rel?: string;
}

const {
  href,
  size = "large",
  variant = "solid",
  class: className,
  tabindex,
  target,
  rel,
} = Astro.props;
---

<a class:list={[styles.button, styles[size], className]} data-variant={variant} href={href} tabindex={tabindex} target={target} rel={rel}>
  <slot />
</a>

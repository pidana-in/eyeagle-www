---
import styles from "../../styles/HomeV3/system-map-tabs.module.css";
import Image from "../common/OptimizedImage.astro";
import insideImage from "../../assets/HomeV3/system-map-inside.png";
import outsideImage from "../../assets/HomeV3/system-map-outside.png";
---

<section class={styles.section} aria-label="EyEagle hardware around the home" data-scene data-system-map>
  <div class={styles.scene} data-system-map-scene>
    <div class={styles.tabs} role="tablist" aria-label="System location" data-reveal data-system-map-tabs>
      <span aria-hidden="true" class={styles.indicator} data-system-map-indicator data-placement="inside"></span>
      <button aria-controls="system-location-panel" aria-selected="true" class={styles.tab} id="system-location-inside" role="tab" tabindex="0" type="button" data-placement="inside">Inside</button>
      <button aria-controls="system-location-panel" aria-selected="false" class={styles.tab} id="system-location-outside" role="tab" tabindex="-1" type="button" data-placement="outside">Outside</button>
    </div>
    <div aria-labelledby="system-location-inside" class={styles.imageFrame} data-reveal="scale" data-system-map-frame data-placement="inside" id="system-location-panel" role="tabpanel">
      <Image alt="EyEagle SOS button and bathroom hardware, with a locking mechanism on the door" class={styles.image} data-visible="true" data-placement="inside" layout="full-width" src={insideImage} />
      <Image alt="EyEagle control and alarm hardware installed outside the bathroom" aria-hidden="true" class={styles.image} data-visible="false" data-placement="outside" layout="full-width" src={outsideImage} />
    </div>
  </div>
</section>

<script>
  import { onScroll } from "../../scripts/scroll-ticker";

  const section = document.querySelector<HTMLElement>("[data-system-map]");
  const tabList = section?.querySelector<HTMLElement>("[data-system-map-tabs]");
  const tabs = Array.from(section?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const images = Array.from(section?.querySelectorAll<HTMLImageElement>("[data-system-map-frame] img") ?? []);
  const indicator = section?.querySelector<HTMLElement>("[data-system-map-indicator]");
  const frame = section?.querySelector<HTMLElement>("[data-system-map-frame]");

  /* While the section is pinned, scroll position picks the side of the door
     you are looking at. The thresholds sit either side of the midpoint so a
     scroll that stalls on the boundary cannot flicker between the two. */
  const ENTER_OUTSIDE = 0.54;
  const ENTER_INSIDE = 0.4;
  /* Where to land when a tab is clicked instead of scrolled to. */
  const REST = { inside: 0.16, outside: 0.78 } as const;

  type Placement = "inside" | "outside";
  let placement: Placement = "inside";
  /* Set while a click-driven scroll is still travelling, so the tab the user
     pressed is not overridden by the positions it passes on the way. */
  let pending: Placement | null = null;
  let pendingTimer = 0;

  const setPlacement = (next: Placement, focus = false) => {
    placement = next;
    indicator?.setAttribute("data-placement", next);
    frame?.setAttribute("data-placement", next);
    frame?.setAttribute("aria-labelledby", `system-location-${next}`);
    tabs.forEach((tab) => {
      const selected = tab.dataset.placement === next;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
      if (selected && focus) tab.focus();
    });
    images.forEach((image) => {
      const visible = image.dataset.placement === next;
      image.dataset.visible = String(visible);
      image.setAttribute("aria-hidden", String(!visible));
    });
  };

  const isPinned = () => section?.dataset.sceneActive === "true";

  const progress = () => {
    if (!section) return 0;
    const travel = Math.max(1, section.offsetHeight - window.innerHeight);
    const value = -section.getBoundingClientRect().top / travel;
    return value < 0 ? 0 : value > 1 ? 1 : value;
  };

  const update = () => {
    if (!isPinned()) return;
    const value = progress();
    const next: Placement = placement === "inside"
      ? (value >= ENTER_OUTSIDE ? "outside" : "inside")
      : (value <= ENTER_INSIDE ? "inside" : "outside");

    if (pending) {
      // Wait until the travelling scroll actually reaches the pressed side.
      if (next !== pending) return;
      pending = null;
      window.clearTimeout(pendingTimer);
    }
    if (next !== placement) setPlacement(next);
  };

  const select = (next: Placement, focus = false) => {
    setPlacement(next, focus);
    if (!isPinned() || !section) return;
    // Keep scroll position and tab state in agreement: jump to the stretch of
    // the pinned section that this side belongs to.
    const travel = Math.max(1, section.offsetHeight - window.innerHeight);
    const top = section.getBoundingClientRect().top + window.scrollY + travel * REST[next];
    pending = next;
    window.clearTimeout(pendingTimer);
    pendingTimer = window.setTimeout(() => { pending = null; }, 1200);
    window.scrollTo({ top, behavior: "smooth" });
  };

  tabs.forEach((tab) => tab.addEventListener("click", () => select((tab.dataset.placement as Placement) ?? "inside")));

  tabList?.addEventListener("keydown", (event) => {
    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
    event.preventDefault();
    if (event.key === "Home") return select("inside", true);
    if (event.key === "End") return select("outside", true);
    select(placement === "inside" ? "outside" : "inside", true);
  });

  setPlacement("inside");
  onScroll(update);
</script>

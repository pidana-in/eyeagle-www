---
import Image from "../common/OptimizedImage.astro";
interface Testimonial {
  quote: string;
  author: string;
  image: ImageMetadata;
}

interface TestimonialData {
  title: string;
  subtitle: string;
  testimonials: Testimonial[];
}

const { testimonialData } = Astro.props as {
  testimonialData: TestimonialData;
};
---

<section class="py-14 md:py-30">
  <div class="container mx-auto">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
      <div class="max-w-200 mx-auto">
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold text-neutral-800">
          {testimonialData.title}
        </h2>
        <p
          class="mt-5 md:mt-10 text-sm sm:text-base md:text-xl text-neutral-600 font-medium"
        >
          {testimonialData.subtitle}
        </p>
      </div>
      <div class="relative max-w-240 mx-auto mt-12 md:mt-25 px-10 md:px-16">
        <!-- Left Arrow -->
        <button
          id="prev-btn"
          type="button"
          aria-label="Previous testimonial"
          class="absolute -left-5 lg:-left-9 xl:-left-25 top-[24%] -translate-y-1/2 text-primary hover:text-[#a30000] transition-all duration-300 hover:scale-110"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-10 h-10 md:w-14 md:h-14"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <!-- Right Arrow -->
        <button
          id="next-btn"
          type="button"
          aria-label="Next testimonial"
          class="absolute -right-5 lg:-right-9 xl:-right-25 top-[24%] -translate-y-1/2 text-primary hover:text-[#a30000] transition-all duration-300 hover:scale-110"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-10 h-10 md:w-14 md:h-14"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
        <span
          class="absolute left-0 top-0 text-primary text-4xl sm:text-5xl md:text-7xl leading-none"
        >
          “
        </span>
        <span
          class="absolute right-0 bottom-28 text-primary text-4xl sm:text-5xl md:text-7xl leading-none"
        >
          ”
        </span>
        <div id="testimonial-content" class="relative w-full">
          {
            testimonialData.testimonials.map((item, index) => (
              <div
                class={`testimonial ${index === 0 ? "" : "hidden"} text-center`}
                aria-hidden={index !== 0}
              >
                <p class="min-h-45 md:min-h-55 text-lg sm:text-xl md:text-[32px] leading-relaxed md:leading-10 text-neutral-800 font-medium">
                  {item.quote}
                </p>
                <div class="mt-10 flex justify-center">
                  <div class="w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden shadow-lg">
                    <Image
                      src={item.image}
                      alt={item.author}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
                <p class="mt-4 md:mt-5 text-neutral-800 text-base md:text-lg font-medium italic">
                  {item.author}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  let current = 0;
  const cards = document.querySelectorAll(
    "#testimonial-content > .testimonial",
  );
  function show(index) {
    cards.forEach((card, i) => {
      card.classList.toggle("hidden", i !== index);
      card.setAttribute("aria-hidden", String(i !== index));
    });
  }
  show(0);
  document.getElementById("next-btn")?.addEventListener("click", () => {
    current = (current + 1) % cards.length;
    show(current);
  });
  document.getElementById("prev-btn")?.addEventListener("click", () => {
    current = (current - 1 + cards.length) % cards.length;
    show(current);
  });
</script>

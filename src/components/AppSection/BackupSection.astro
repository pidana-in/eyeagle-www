---
import Image from "../common/OptimizedImage.astro";
import MaterialIcon from "../common/MaterialIcon.astro";

const backupSection = Astro.props.backupSection;
---

<section class="py-10 px-4 flex justify-center xl:container">
  <div
    class="w-full max-w-7xl bg-white rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-sm"
  >
    <!-- Left Content -->
    <div class="bg-[#FEF7EB] p-6 md:p-14 flex flex-col justify-center md:w-1/2">
      <p
        class="text-primary text-sm font-semibold tracking-[4px] uppercase mb-4"
      >
        {backupSection.eyebrow}
      </p>
      <h2
        class="text-[28px] leading-8 md:text-[40px] font-bold md:leading-12 mb-8"
      >
        When your Nest can’t <br class="md:block hidden" /> respond, we do
      </h2>
      <p class="text-[#090D15] opacity-80 leading-relaxed mb-8">
        {backupSection.description}
      </p>
      <p
        class="flex gap-2 text-primary text-base font-medium italic md:mt-auto my-4 items-center"
      >
        <MaterialIcon name="error" classNames="w-4 h-4 shrink-0" />
        <span>{backupSection.warning}</span>
      </p>
    </div>
    <!-- Right Image -->
    <div class="md:w-1/2">
      <Image
        src={backupSection.img}
        alt="Backup Image"
        class="w-full h-full object-cover md:rounded-r-2xl"
      />
    </div>
  </div>
</section>

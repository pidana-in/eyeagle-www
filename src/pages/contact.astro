---
import Image from "../components/common/OptimizedImage.astro";
import MainLayout from "../layouts/MainLayout.astro";
import {
  HERO,
  ACTION_CARDS,
  PARTNER_CARD,
  INFO_CARDS,
} from "../components/constants/contactus";
const metaTitle = "Reach Out for Queries & Support - Contact EyEagle";
const metaDesc =
  "Need help or have questions about EyEagle’s emergency alarm systems? Contact us today for reliable customer support and assistance.";
---

<MainLayout title={metaTitle} desc={metaDesc} schemaType="ContactPage">
  <section class="bg-[#F6F4F2]">
    <div class="mx-auto max-w-[1728px] px-4 py-14 lg:py-20 lg:px-30">
      <div class="grid lg:grid-cols-2 gap-15 items-center">
        <div class="lg:max-w-140.5">
          <h1
            class="text-[40px] lg:text-5xl lg:leading-14 leading-12 font-semibold tracking-[-0.02em]"
          >
            {HERO.heading}
          </h1>
          <p class="mt-6 text-[#525252] text-lg leading-8">
            {HERO.description}
          </p>
        </div>
        <Image
          src={HERO.image}
          alt={HERO.imageAlt}
          class="w-full rounded-2xl object-cover"
        />
      </div>
    </div>
  </section>
  <section>
    <div class="mx-auto max-w-[1728px] px-4 lg:px-30 py-20">
      <!-- Top Cards -->
      <div class="grid lg:grid-cols-2 gap-10">
        {
          ACTION_CARDS.map((card) => (
            <div>
              <Image
                src={card.image}
                alt={card.alt}
                class="w-full rounded-2xl"
              />
              <h2 class="my-4 text-2xl font-bold">{card.title}</h2>
              <p class="text-base font-medium text-[#525252]">
                {card.description}
              </p>
              <a
                href={card.ctaHref}
                class="inline-flex mt-8 px-5 py-3 rounded-full text-[#262626] font-semibold border border-[#000000] hover:bg-[#000000] hover:text-white transition"
              >
                {card.ctaLabel}
              </a>
            </div>
          ))
        }
      </div>

      <!-- Partner Card -->
      <div class="flex justify-center lg:mt-20 mt-10">
        <div class="w-full lg:max-w-140">
          <Image
            src={PARTNER_CARD.image}
            alt={PARTNER_CARD.alt}
            class="w-full rounded-2xl"
          />
          <h2 class="my-4 text-2xl font-bold">{PARTNER_CARD.title}</h2>
          <p class="text-base font-medium text-[#525252]">
            {PARTNER_CARD.description}
          </p>
          <a
            href={PARTNER_CARD.ctaHref}
            class="inline-flex mt-8 px-5 py-3 rounded-full text-[#262626] font-semibold border border-[#000000] hover:bg-[#000000] hover:text-white transition"
          >
            {PARTNER_CARD.ctaLabel}
          </a>
        </div>
      </div>

      <!-- Bottom Cards -->
      <div class="grid lg:grid-cols-2 gap-8 mt-24">
        {
          INFO_CARDS.map((card) => (
            <div class="rounded-3xl border border-[#E5E5E5] p-5 text-[#525252]">
              <Image src={card.logo} alt={card.alt} class="w-13 h-13" />
              <h3 class="text-[28px] font-medium mb-3">{card.title}</h3>
              {card.lines ? (
                card.lines.map((line, i) => (
                  <a
                    href={line.href}
                    class={`block text-lg text-[#525252] hover:text-primary ${i > 0 ? "mt-3" : ""}`}
                  >
                    {line.text}
                  </a>
                ))
              ) : (
                <p class="text-[#525252] text-lg">{card.text}</p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
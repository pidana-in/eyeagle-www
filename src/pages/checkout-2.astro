---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/HomeV3/SiteHeader.astro";
import Image from "../components/common/OptimizedImage.astro";
import { SHOP_URLS } from "../data/shop";
import styles from "../styles/StoreV2/page.module.css";
import "../styles/home-v3-tokens.css";

import kit from "../assets/Store/guardian-kit-v2.png";
import installedButton from "../assets/Store/sos-installed-v2.png";
import sensor from "../assets/Store/door-sensor-v2.png";
import livingRoomAlarm from "../assets/Store/ecu-living-room-v1.png";
import checkIcon from "../assets/CheckoutFigma/check.svg";
import removeIcon from "../assets/CheckoutFigma/remove.svg";
import addIcon from "../assets/CheckoutFigma/add.svg";
import arrowIcon from "../assets/CheckoutFigma/arrow-outward.svg";

const views = [
  { image: kit, alt: "EyEagle alarm unit, SOS button, door sensor and latch arranged in a bathroom", label: "Complete system", contain: false },
  { image: installedButton, alt: "A hand pressing the installed EyEagle SOS button", label: "SOS button", contain: false },
  { image: sensor, alt: "EyEagle bathroom door sensor and latch", label: "Door sensor", contain: true },
  { image: livingRoomAlarm, alt: "EyEagle alarm unit mounted in the home", label: "Alarm unit", contain: false },
] as const;

const included = ["Hardware", "Installation", "Nest & response"] as const;
---

<MainLayout
  title="Become an EyEagle member | Checkout concept 2"
  desc="Configure your EyEagle home safety system, including professional installation, Nest and three years of response membership."
  noindex={true}
  showChrome={false}
  bodyClass="eyeagle-home-v3"
>
  <SiteHeader slot="header" solidAtTop showNavigation={false} showAction={false} variant="figmaHome" />
  <main class={styles.main} id="main-content">
    <section class={styles.checkout} aria-labelledby="checkout-title">
      <div class={styles.gallery}>
        <div class={styles.galleryStage}>
          {views.map((view, index) => (
            <figure data-gallery-panel={index} hidden={index !== 0} id={`product-view-${index}`}>
              <Image
                alt={view.alt}
                class:list={[styles.productImage, view.contain && styles.containImage]}
                fetchpriority={index === 0 ? "high" : "auto"}
                layout="full-width"
                loading={index === 0 ? "eager" : "lazy"}
                quality={90}
                src={view.image}
              />
            </figure>
          ))}
        </div>
        <div class={styles.thumbnailGrid} aria-label="Product views">
          {views.slice(0, 4).map((view, index) => (
            <button aria-controls={`product-view-${index}`} aria-label={`View ${view.label}`} aria-pressed={index === 0 ? "true" : "false"} data-gallery-button={index} type="button">
              <Image alt="" class={styles.thumbnailImage} layout="full-width" quality={82} src={view.image} />
            </button>
          ))}
        </div>
      </div>

      <div class={styles.configuration}>
        <div class={styles.configurationBody}>
          <header class={styles.heading}>
            <h1 id="checkout-title">The EyEagle system.</h1>
            <div class={styles.included} aria-label="Included with your system">
              {included.map((item) => <span><img alt="" src={checkIcon.src} />{item}</span>)}
            </div>
          </header>

          <div class={styles.divider}></div>

          <section class={styles.kitSection} aria-labelledby="kit-title">
            <h2 id="kit-title">Your kit</h2>
            <div class={styles.kitCard} aria-label="EyEagle system selected">
              <div><h3>EyEagle System</h3><p>Hardware, professional installation, Nest and three years of response membership.</p></div>
              <strong>$799</strong>
            </div>
          </section>

          <div class={styles.divider}></div>

          <section class={styles.addons} aria-labelledby="addons-title">
            <h2 id="addons-title">Add more</h2>
            <div class={styles.addonList}>
              <div class={styles.addonRow}>
                <div><h3>Total bathrooms</h3><p>1 included <span>•</span> $200 each additional bathroom</p></div>
                <div class={styles.stepper}>
                  <button aria-label="Decrease total bathrooms" data-delta="-1" data-quantity="bathrooms" disabled type="button"><img alt="" src={removeIcon.src} /></button>
                  <output data-output="bathrooms" for="bathrooms">1</output>
                  <input id="bathrooms" min="1" max="3" value="1" type="hidden" />
                  <button aria-label="Increase total bathrooms" data-delta="1" data-quantity="bathrooms" type="button"><img alt="" src={addIcon.src} /></button>
                </div>
              </div>

              <div class={styles.addonRow}>
                <div><h3>Total SOS buttons</h3><p>1 included <span>•</span> $100 per additional button</p></div>
                <div class={styles.stepper}>
                  <button aria-label="Decrease total SOS buttons" data-delta="-1" data-quantity="sos" disabled type="button"><img alt="" src={removeIcon.src} /></button>
                  <output data-output="sos" for="sos">1</output>
                  <input id="sos" min="1" max="4" value="1" type="hidden" />
                  <button aria-label="Increase total SOS buttons" data-delta="1" data-quantity="sos" type="button"><img alt="" src={addIcon.src} /></button>
                </div>
              </div>
            </div>
            <p class={styles.setupNote}>Need a larger setup? <a href="/contact">Talk to us</a>.</p>
          </section>
        </div>

        <div class={styles.checkoutBar}>
          <div class={styles.priceBlock}>
            <strong data-total-price>$799</strong>
            <p data-order-summary>1 bathroom · 1 SOS button</p>
            <small>USD · excluding GST</small>
          </div>
          <a class={styles.checkoutButton} href={SHOP_URLS.protectionKit} data-checkout-link>
            Checkout <img alt="" src={arrowIcon.src} />
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-panel]"));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-button]"));
  buttons.forEach((button) => button.addEventListener("click", () => {
    const selected = button.dataset.galleryButton;
    panels.forEach((panel) => panel.hidden = panel.dataset.galleryPanel !== selected);
    buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
  }));

  const inputs = {
    bathrooms: document.querySelector<HTMLInputElement>("#bathrooms"),
    sos: document.querySelector<HTMLInputElement>("#sos"),
  };

  const updateConfiguration = () => {
    if (!inputs.bathrooms || !inputs.sos) return;
    const bathrooms = Number(inputs.bathrooms.value);
    const sos = Number(inputs.sos.value);
    const total = 799 + (bathrooms - 1) * 200 + (sos - 1) * 100;
    const price = document.querySelector<HTMLElement>("[data-total-price]");
    const summary = document.querySelector<HTMLElement>("[data-order-summary]");
    if (price) price.textContent = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(total);
    if (summary) summary.textContent = `${bathrooms} bathroom${bathrooms === 1 ? "" : "s"} · ${sos} SOS button${sos === 1 ? "" : "s"}`;
    (Object.keys(inputs) as Array<keyof typeof inputs>).forEach((key) => {
      const input = inputs[key];
      if (!input) return;
      const output = document.querySelector<HTMLOutputElement>(`[data-output="${key}"]`);
      if (output) output.value = input.value;
      document.querySelectorAll<HTMLButtonElement>(`[data-quantity="${key}"]`).forEach((button) => {
        const next = Number(input.value) + Number(button.dataset.delta);
        button.disabled = next < Number(input.min) || next > Number(input.max);
      });
    });
  };

  document.querySelectorAll<HTMLButtonElement>("[data-quantity]").forEach((button) => button.addEventListener("click", () => {
    const key = button.dataset.quantity as keyof typeof inputs;
    const input = inputs[key];
    if (!input) return;
    const next = Number(input.value) + Number(button.dataset.delta);
    input.value = String(Math.min(Number(input.max), Math.max(Number(input.min), next)));
    updateConfiguration();
  }));
  updateConfiguration();
</script>

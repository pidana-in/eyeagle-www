---
import MainLayout from "../layouts/MainLayout.astro";
import Image from "../components/common/OptimizedImage.astro";
import SiteHeader from "../components/HomeV3/SiteHeader.astro";
import SiteFooter from "../components/HomeV3/SiteFooter.astro";
import FAQSection from "../components/HomeV3/FAQSection.astro";
import {
  EYEAGLE_DEFAULT_MEMBERSHIP_MONTHS as defaultMembershipMonths,
  EYEAGLE_MEMBERSHIP_PLANS,
  EYEAGLE_ORDERING_OPEN as orderingOpen,
  EYEAGLE_SHOPIFY_CONFIG,
  estimateGstInr,
  formatInr,
  getEyEagleConfiguredPurchase,
} from "../data/shopify-configurator";
import styles from "../styles/Store/page.module.css";
import "../styles/home-v3-tokens.css";
import "../styles/home-v4-tokens.css";
import kitImage from "../assets/Store/guardian-kit-v2.png";
import setupImage from "../assets/Store/sos-installed-v2.png";
import reviewImage from "../assets/Store/ecu-living-room-v1.png";
import protectionKitImage from "../assets/NewHome/kit.png";
import membershipImage from "../assets/Store/membership-app-hospital-v1.png";

const {
  basePriceInr,
  additionalBathroomPriceInr,
  additionalSosPriceInr,
  bathroomMin,
  bathroomMax,
  additionalSosMin,
  additionalSosMax,
  gstRate,
  membershipMonthlyInr,
} = EYEAGLE_SHOPIFY_CONFIG;

const panels = [
  { image: kitImage, alt: "The complete EyEagle home safety system", caption: "Complete home safety system" },
  { image: setupImage, alt: "The EyEagle Alert Unit installed within reach", caption: "SOS within reach" },
  { image: reviewImage, alt: "The EyEagle Home Hub with Alarm installed in a living room", caption: "Installed, connected and ready" },
  { image: protectionKitImage, alt: "EyEagle bathroom protection supports installed in a home", caption: "Bathroom protection, within reach" },
  // Built by scripts/compose-store-membership-image.mjs. The phone sits low in the frame, so crops
  // keep the lower part in view.
  { image: membershipImage, alt: "The EyEagle app showing an SOS alert and who is responding, over a hospital where EyEagle Response arranges care", caption: "Nest app and 24/7 response", focus: styles.focusLower },
] as const;

const range = (min: number, max: number) => Array.from({ length: max - min + 1 }, (_, index) => min + index);
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`;

// Each bathroom gets a protection kit and its own Alert Unit.
const bathroomDescriptions: Record<number, string> = {
  1: "For parents who use one bathroom. A protection kit and Alert Unit, installed.",
  2: "Covers both bathrooms in a 2 BHK, each with its own kit and Alert Unit.",
  3: "For larger homes, or a guest bathroom they also use. Kit and Alert Unit in each.",
};
const bathroomOptions = range(bathroomMin, bathroomMax).map((count) => ({
  value: count,
  title: plural(count, "bathroom"),
  description: bathroomDescriptions[count] ?? "A protection kit and Alert Unit in each bathroom.",
  priceInr: (count - bathroomMin) * additionalBathroomPriceInr,
}));

// Extra Alert Units go beyond the bathrooms, wherever else they spend time.
const sosDescriptions: Record<number, string> = {
  0: "Each protected bathroom already has its own Alert Unit.",
  1: "One more where they spend the most time, like beside the bed.",
  2: "Cover the bedroom and one more spot, like the kitchen or stairs.",
  3: "Bedroom, kitchen and stairs, or the places they move around most.",
  4: "Every room they use, including a puja room or balcony.",
};
const sosOptions = range(additionalSosMin, additionalSosMax).map((extra) => ({
  value: extra,
  title: extra === 0 ? "No extra units" : plural(extra, "extra Alert Unit"),
  description: sosDescriptions[extra] ?? "Extra Alert Units for the other rooms they use.",
  priceInr: extra * additionalSosPriceInr,
}));

// Paying ahead is discounted against the monthly rate; the tiles show what it saves.
const membershipOptions = ([36, 12, 0] as const).map((months) => ({
  value: months,
  title: EYEAGLE_MEMBERSHIP_PLANS[months].title,
  priceInr: EYEAGLE_MEMBERSHIP_PLANS[months].priceInr,
  period: months === 36 ? "three years" : "one year",
  savingInr: months * membershipMonthlyInr - EYEAGLE_MEMBERSHIP_PLANS[months].priceInr,
}));
// GST applies to the monthly membership too.
const membershipMonthlyWithGstInr = membershipMonthlyInr + estimateGstInr(membershipMonthlyInr);

const defaultPurchase = getEyEagleConfiguredPurchase(bathroomMin, additionalSosMin, defaultMembershipMonths);
if (!defaultPurchase) throw new Error("The default EyEagle configuration is invalid.");
if (orderingOpen && !defaultPurchase.checkoutUrl) throw new Error("Ordering is open, but the default configuration has no Shopify variant.");
const basePrice = formatInr(basePriceInr);
const gstPercent = `${Math.round(gstRate * 100)}%`;
const defaultMembershipInr = EYEAGLE_MEMBERSHIP_PLANS[defaultMembershipMonths].priceInr;
const defaultTotalInr = defaultPurchase.totalInr;
const defaultGstInr = estimateGstInr(defaultTotalInr);
const defaultWithGstInr = defaultTotalInr + defaultGstInr;
const defaultTotal = formatInr(defaultTotalInr);
const defaultGst = formatInr(defaultGstInr);
const defaultWithGst = formatInr(defaultWithGstInr);

const faqItems = [
  {
    question: "Do prices include GST?",
    answer: `No. Prices are before GST, and GST (${gstPercent}) is added at checkout. For the standard system with three years of membership that is ${defaultTotal} + ${defaultGst} GST, or ${defaultWithGst} in total. Your GST invoice is issued with the order.`,
  },
  orderingOpen
    ? {
      question: "When will my system ship?",
      answer: "Shipping starts October 30. After you order, installation details and the response plan are completed with our team.",
    }
    : {
      question: "When can I order?",
      answer: "Ordering isn’t open yet. Leave your email under “Get availability updates” and we’ll let you know as soon as it opens.",
    },
  {
    question: "How is the system installed?",
    answer: "An EyEagle team member reviews the home, positions the Alert Unit (SOS button and Door Lock Sensor) and the Home Hub, connects the Nest and tests the complete alert path before handover.",
  },
  {
    question: "How does membership work?",
    answer: `Membership covers the Nest, readiness checks and EyEagle Response. It is ${formatInr(membershipMonthlyInr)}/month + ${gstPercent} GST (${formatInr(membershipMonthlyWithGstInr)}/month in total), or pay ahead when you order: ${formatInr(EYEAGLE_MEMBERSHIP_PLANS[12].priceInr)} for one year or ${formatInr(EYEAGLE_MEMBERSHIP_PLANS[36].priceInr)} for three years. After a paid-ahead period it continues monthly until cancelled.`,
  },
  {
    question: "Does EyEagle need home Wi-Fi?",
    answer: "No. The installed system uses built-in 4G connectivity, so raising an SOS does not depend on the home’s Wi-Fi network. Connectivity is checked during installation.",
  },
  {
    question: "Do my parents need a smartphone?",
    answer: "No. They can raise an SOS using the installed button. The app is primarily for Nest members who receive alerts and coordinate the response.",
  },
  {
    question: "What if the home needs a larger setup?",
    answer: "Online orders cover up to three bathrooms and four extra Alert Units. For larger homes, talk to us and we’ll plan the installation with you.",
  },
] as const;
---

<MainLayout socialCard="store" title="Buy EyEagle | Home safety system with response" desc="Configure an EyEagle home safety system with professional installation, the Nest app and EyEagle Response membership." showChrome={false} bodyClass="eyeagle-home-v3 eyeagle-home-v4">
  <SiteHeader slot="header" solidAtTop showAction={false} variant="figmaHome" />

  <main class={styles.main} id="main-content">
    <div class={styles.bar} data-store-bar data-visible="true">
      <div class={styles.barInner}>
        <p class={styles.barName}>EyEagle Home System</p>
        <p class={styles.barPrice}><strong data-total-price data-inr={defaultTotalInr}>{defaultTotal}</strong> <span>+ GST <small class={styles.inrAlt} data-total-price data-inr-alt={defaultTotalInr} data-suffix=" + GST" hidden></small></span></p>
        {orderingOpen ? (
          <a class={styles.barAction} data-checkout href={defaultPurchase.checkoutUrl}><span class={styles.barActionLong}>Continue to checkout</span><span class={styles.barActionShort}>Checkout</span></a>
        ) : (
          <a class={styles.barAction} href="#availability"><span class={styles.barActionLong}>Get availability updates</span><span class={styles.barActionShort}>Notify me</span></a>
        )}
      </div>
    </div>

    <div class={styles.layout}>
      <header class={styles.intro}>
        <div>
          {orderingOpen
            ? <p class={styles.eyebrow}>Shipping starts October 30</p>
            : <p class={styles.eyebrow}><span class={styles.dot} aria-hidden="true"></span> Ordering is currently unavailable</p>}
          <h1>Buy EyEagle</h1>
          <p class={styles.introPrice}>From <span data-inr={basePriceInr}>{basePrice}</span> <span>+ GST <small class={styles.inrAlt} data-inr-alt={basePriceInr} data-suffix=" + GST" hidden></small> · installation included, membership from <span data-inr={membershipMonthlyInr}>{formatInr(membershipMonthlyInr)}</span>/month + GST</span></p>
        </div>
        <ul class={styles.introLinks}>
          <li><span class={styles.dot} aria-hidden="true"></span>Professional installation in India</li>
          <li><a href="/contact">Talk to a specialist <span aria-hidden="true">↗</span></a></li>
        </ul>
      </header>

      <section class={styles.gallery} aria-label="EyEagle system photos">
        <div class={styles.galleryStage}>
          {panels.map((panel, index) => (
            <div class={styles.galleryPanel} aria-hidden={index === 0 ? undefined : "true"} data-active={String(index === 0)} data-gallery-panel={index}>
              <Image alt={panel.alt} class={`${styles.galleryImage} ${"focus" in panel ? panel.focus : ""}`} fetchpriority={index === 0 ? "high" : "auto"} layout="full-width" loading={index === 0 ? "eager" : "lazy"} quality={90} src={panel.image} />
            </div>
          ))}
          <p class={styles.galleryCaption} data-gallery-caption aria-live="polite">{panels[0].caption}</p>
        </div>
        <div class={styles.galleryControls}>
          <button aria-label="Previous photo" class={styles.galleryArrow} data-gallery-step="-1" type="button">‹</button>
          <div class={styles.galleryDots}>
            {panels.map((panel, index) => (
              <button aria-label={`Show photo ${index + 1}: ${panel.caption}`} aria-pressed={index === 0 ? "true" : "false"} data-gallery-dot={index} type="button"><span></span></button>
            ))}
          </div>
          <button aria-label="Next photo" class={styles.galleryArrow} data-gallery-step="1" type="button">›</button>
        </div>
      </section>

      <form class={styles.options} data-configurator>
        <section class={styles.group} aria-labelledby="system-title" data-gallery-target="0">
          <h2 class={styles.groupTitle} id="system-title"><strong>System.</strong> Everything one bathroom needs.</h2>
          <div class={styles.systemCard}>
            <div class={styles.systemHead}>
              <h3>Complete Home System</h3>
              <p><strong data-inr={basePriceInr}>{basePrice}</strong><span>+ GST <small class={styles.inrAlt} data-inr-alt={basePriceInr} data-suffix=" + GST" hidden></small></span></p>
            </div>
            <ul>
              <li>Alert Unit with SOS button and Door Lock Sensor</li>
              <li>Home Hub with Alarm</li>
              <li>Bathroom protection kit for one bathroom</li>
              <li>Professional installation and testing</li>
              <li>Nest app for family and trusted contacts</li>
            </ul>
          </div>
          <details class={styles.help}>
            <summary>What happens during installation?</summary>
            <p>An EyEagle team member reviews the home, positions the Alert Unit (SOS button and Door Lock Sensor) and the Home Hub, connects the Nest and tests the complete alert path before handover.</p>
          </details>
        </section>

        <fieldset class={styles.group} data-gallery-target="3">
          <legend class={styles.groupTitle}><strong>Bathrooms.</strong> How many do they use?</legend>
          <div class={styles.groupMedia}><Image alt={panels[3].alt} class={styles.groupMediaImage} layout="full-width" loading="lazy" quality={85} src={panels[3].image} /></div>
          <div class={styles.tiles}>
            {bathroomOptions.map((option) => (
              <label class={styles.tile}>
                <input checked={option.value === bathroomMin} name="bathrooms" type="radio" value={option.value} />
                <span class={styles.tileBody}>
                  <span class={styles.tileTitle}>{option.title}</span>
                  <span class={styles.tileText}>{option.description}</span>
                </span>
                <span class={styles.tilePrice}>{option.priceInr === 0 ? "Included" : <>+ <span data-inr={option.priceInr}>{formatInr(option.priceInr)}</span><small class={styles.inrAlt} data-inr-alt={option.priceInr} hidden></small></>}</span>
              </label>
            ))}
          </div>
          <a class={styles.help} href="/contact">
            <span>Need more than {bathroomMax} bathrooms?</span>
            <span class={styles.helpMuted}>Talk to us about a larger setup <span aria-hidden="true">↗</span></span>
          </a>
        </fieldset>

        <fieldset class={styles.group} data-gallery-target="1">
          <legend class={styles.groupTitle}><strong>Extra Alert Units.</strong> SOS beyond the bathroom.</legend>
          <div class={styles.groupMedia}><Image alt={panels[1].alt} class={styles.groupMediaImage} layout="full-width" loading="lazy" quality={85} src={panels[1].image} /></div>
          <div class={styles.tiles}>
            {sosOptions.map((option) => (
              <label class={styles.tile}>
                <input checked={option.value === additionalSosMin} name="sos" type="radio" value={option.value} />
                <span class={styles.tileBody}>
                  <span class={styles.tileTitle}>{option.title}</span>
                  <span class={styles.tileText}>{option.description}</span>
                </span>
                <span class={styles.tilePrice}>{option.priceInr === 0 ? "Included" : <>+ <span data-inr={option.priceInr}>{formatInr(option.priceInr)}</span><small class={styles.inrAlt} data-inr-alt={option.priceInr} hidden></small></>}</span>
              </label>
            ))}
          </div>
          <details class={styles.help}>
            <summary>Where should extra Alert Units go?</summary>
            <p>Wherever a fall could happen and a phone is out of reach. Our team confirms placement during the home review before installation.</p>
          </details>
        </fieldset>

        <fieldset class={styles.group} data-gallery-target="4">
          <legend class={styles.groupTitle}><strong>Membership.</strong> Pay ahead and save.</legend>
          <div class={styles.groupMedia}><Image alt={panels[4].alt} class={`${styles.groupMediaImage} ${panels[4].focus}`} layout="full-width" loading="lazy" quality={85} src={panels[4].image} /></div>
          <div class={styles.tiles}>
            {membershipOptions.map((option) => (
              <label class={styles.tile}>
                <input checked={option.value === defaultMembershipMonths} name="membership" type="radio" value={option.value} />
                <span class={styles.tileBody}>
                  <span class={styles.tileTitle}>{option.title}</span>
                  {option.value === 0
                    ? <span class={styles.tileText}>Nest, readiness checks and EyEagle Response, billed monthly from installation: <span data-inr={membershipMonthlyWithGstInr}>{formatInr(membershipMonthlyWithGstInr)}</span>/month with {gstPercent} GST.</span>
                    : <span class={styles.tileText}>Nest, readiness checks and EyEagle Response for {option.period}. Saves <span data-inr={option.savingInr}>{formatInr(option.savingInr)}</span> on paying monthly.</span>}
                </span>
                <span class={styles.tilePrice}>{option.value === 0
                  ? <><span data-inr={membershipMonthlyInr}>{formatInr(membershipMonthlyInr)}</span>/month<small class={styles.inrAlt} data-inr-alt={membershipMonthlyInr} data-suffix="/month" hidden></small><small class={styles.tileGst}>+ GST</small></>
                  : <>+ <span data-inr={option.priceInr}>{formatInr(option.priceInr)}</span><small class={styles.inrAlt} data-inr-alt={option.priceInr} hidden></small></>}</span>
              </label>
            ))}
          </div>
          <details class={styles.help}>
            <summary>What happens when a paid-ahead membership ends?</summary>
            <p>It continues at {formatInr(membershipMonthlyInr)}/month + GST until cancelled, so response never lapses by accident. Monthly membership is billed separately from this order.</p>
          </details>
        </fieldset>
      </form>
    </div>

    <section class={styles.summary} aria-labelledby="summary-title" data-store-summary>
      <div class={styles.summaryInner}>
        <div>
          {orderingOpen
            ? <h2 id="summary-title">Your EyEagle system is ready. <span>Make it theirs.</span></h2>
            : <h2 id="summary-title">Your EyEagle setup. <span>We’ll tell you when ordering opens.</span></h2>}
          <dl class={styles.summaryList}>
            <div><dt>Complete Home System</dt><dd><span data-inr={basePriceInr}>{basePrice}</span><small class={styles.inrAlt} data-inr-alt={basePriceInr} hidden></small></dd></div>
            <div data-summary-bathrooms hidden><dt data-summary-bathrooms-label></dt><dd><span data-summary-bathrooms-price data-inr="0"></span><small class={styles.inrAlt} data-summary-bathrooms-price data-inr-alt="0" hidden></small></dd></div>
            <div data-summary-sos hidden><dt data-summary-sos-label></dt><dd><span data-summary-sos-price data-inr="0"></span><small class={styles.inrAlt} data-summary-sos-price data-inr-alt="0" hidden></small></dd></div>
            <div><dt data-summary-membership-label>Membership · {EYEAGLE_MEMBERSHIP_PLANS[defaultMembershipMonths].title}</dt><dd><span data-summary-membership-price data-inr={defaultMembershipInr}>{formatInr(defaultMembershipInr)}</span><span data-summary-membership-monthly hidden>/month + GST</span><small class={styles.inrAlt} data-summary-membership-price data-inr-alt={defaultMembershipInr} hidden></small></dd></div>
            <div class={styles.summarySubtotal}><dt>Subtotal</dt><dd><span data-total-price data-inr={defaultTotalInr}>{defaultTotal}</span><small class={styles.inrAlt} data-total-price data-inr-alt={defaultTotalInr} hidden></small></dd></div>
            <div><dt>Estimated GST ({gstPercent})</dt><dd><span data-total-gst data-inr={defaultGstInr}>{defaultGst}</span><small class={styles.inrAlt} data-total-gst data-inr-alt={defaultGstInr} hidden></small></dd></div>
            <div class={styles.summaryGrand}><dt>Total with GST</dt><dd><span data-total-with-gst data-inr={defaultWithGstInr}>{defaultWithGst}</span><small class={styles.inrAlt} data-total-with-gst data-inr-alt={defaultWithGstInr} hidden></small></dd></div>
          </dl>
        </div>
        <div class={styles.summaryAction}>
          <p class={styles.summaryTotal}><strong data-total-price data-inr={defaultTotalInr}>{defaultTotal}</strong><span>+ GST · <span data-total-with-gst data-inr={defaultWithGstInr}>{defaultWithGst}</span> total with GST</span><small class={styles.inrAlt} data-total-price data-inr-alt={defaultTotalInr} data-suffix=" + GST" hidden></small></p>
          {orderingOpen ? (
            <>
              <a class={styles.primaryAction} data-checkout href={defaultPurchase.checkoutUrl}>Continue to checkout <span aria-hidden="true">↗</span></a>
              <p class={styles.checkoutError} data-config-error role="alert" hidden>We couldn’t prepare checkout for this configuration. Please review your choices or contact us.</p>
            </>
          ) : (
            <form id="availability" class={styles.notifyForm} data-availability-form novalidate>
              <p class={styles.availabilityState}><span class={styles.dot} aria-hidden="true"></span> Ordering is currently unavailable</p>
              <h3>Get availability updates.</h3>
              <label class={styles.srOnly} for="availability-email">Email address</label>
              <div class={styles.formRow}>
                <input aria-describedby="availability-note availability-status" aria-invalid="false" autocomplete="email" id="availability-email" inputmode="email" name="email" placeholder="Your email address" required type="email" />
                <button type="submit"><span data-submit-label>Notify me</span> <span aria-hidden="true">→</span></button>
              </div>
              <p class={styles.formStatus} data-form-status id="availability-status"></p>
              <p class={styles.formNote} id="availability-note">No marketing.</p>
              <a class={styles.contactLink} href="/contact"><span>Need help?</span> <strong>Talk to us <span aria-hidden="true">↗</span></strong></a>
            </form>
          )}
          <button class={styles.shareAction} data-share type="button">Share this setup with family</button>
          <p class={styles.finePrint}>{orderingOpen && "Shipping starts October 30. "}Checkout is in INR, and prices exclude GST, which is added at checkout. After any membership paid ahead here, it continues at {formatInr(membershipMonthlyInr)}/month + GST, billed separately, until cancelled. Installation is currently available in India.</p>
          <p class={styles.finePrint} data-local-note hidden></p>
        </div>
      </div>
    </section>

    <FAQSection eyebrow="Buying EyEagle" title="Questions before you buy." description="Delivery, installation, pricing and what happens after three years." items={faqItems} id="store-faqs" />
  </main>

  <SiteFooter slot="footer" variant="figmaHome" />
</MainLayout>

<script>
  import {
    EYEAGLE_DEFAULT_MEMBERSHIP_MONTHS,
    EYEAGLE_MEMBERSHIP_PLANS,
    EYEAGLE_SHOPIFY_CONFIG,
    estimateGstInr,
    getEyEagleConfiguredPurchase,
  } from "../data/shopify-configurator";
  import { renderPrices, setPrice } from "../scripts/local-price";

  const form = document.querySelector<HTMLFormElement>("[data-configurator]");
  const bar = document.querySelector<HTMLElement>("[data-store-bar]");
  const summarySection = document.querySelector<HTMLElement>("[data-store-summary]");
  const siteHeader = document.querySelector<HTMLElement>("[data-home-v3-header]");
  const checkoutLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-checkout]"));
  const totalPrices = Array.from(document.querySelectorAll<HTMLElement>("[data-total-price]"));
  const totalGst = Array.from(document.querySelectorAll<HTMLElement>("[data-total-gst]"));
  const totalsWithGst = Array.from(document.querySelectorAll<HTMLElement>("[data-total-with-gst]"));
  const configurationError = document.querySelector<HTMLElement>("[data-config-error]");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-panel]"));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"));
  const caption = document.querySelector<HTMLElement>("[data-gallery-caption]");
  const captions = ["Complete home safety system", "SOS within reach", "Installed, connected and ready", "Bathroom protection, within reach", "Nest app and 24/7 response"];
  const root = document.documentElement;
  const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`;

  // Show an amount (INR) in each price element, or the fallback when there is none.
  const showAmount = (elements: HTMLElement[], amountInr: number | null, fallback: string) => elements.forEach((element) => {
    if (amountInr !== null) setPrice(element, amountInr);
    else if ("inrAlt" in element.dataset) element.hidden = true;
    else element.textContent = fallback;
  });

  renderPrices();

  // Keep sticky elements below the fixed site header, which is always on screen.
  if (siteHeader) {
    const syncHeader = () => {
      const height = Math.round(siteHeader.getBoundingClientRect().height);
      root.style.setProperty("--store-header-h", `${height}px`);
      root.style.setProperty("--store-header-visible", `${height}px`);
    };
    new ResizeObserver(syncHeader).observe(siteHeader);
    syncHeader();
  }

  let currentPanel = 0;
  let captionTimer = 0;
  const showPanel = (index: number) => {
    currentPanel = (index + panels.length) % panels.length;
    panels.forEach((panel, panelIndex) => {
      panel.dataset.active = String(panelIndex === currentPanel);
      panel.toggleAttribute("aria-hidden", panelIndex !== currentPanel);
    });
    dots.forEach((dot, dotIndex) => dot.setAttribute("aria-pressed", String(dotIndex === currentPanel)));
    if (caption && caption.textContent !== captions[currentPanel]) {
      // Fade the caption out, swap the text, then fade back in alongside the photo crossfade.
      caption.dataset.fading = "true";
      window.clearTimeout(captionTimer);
      captionTimer = window.setTimeout(() => {
        caption.textContent = captions[currentPanel];
        caption.dataset.fading = "false";
      }, 220);
    }
  };
  dots.forEach((dot) => dot.addEventListener("click", () => showPanel(Number(dot.dataset.galleryDot))));
  document.querySelectorAll<HTMLButtonElement>("[data-gallery-step]").forEach((button) => {
    button.addEventListener("click", () => showPanel(currentPanel + Number(button.dataset.galleryStep)));
  });

  const readSelection = () => {
    const data = form ? new FormData(form) : null;
    return {
      bathrooms: Number(data?.get("bathrooms") ?? EYEAGLE_SHOPIFY_CONFIG.bathroomMin),
      additionalSos: Number(data?.get("sos") ?? EYEAGLE_SHOPIFY_CONFIG.additionalSosMin),
      membershipMonths: Number(data?.get("membership") ?? EYEAGLE_DEFAULT_MEMBERSHIP_MONTHS),
    };
  };

  const setSummaryRow = (key: "bathrooms" | "sos", count: number, label: string, price: number) => {
    document.querySelector<HTMLElement>(`[data-summary-${key}]`)?.toggleAttribute("hidden", count === 0);
    const labelElement = document.querySelector<HTMLElement>(`[data-summary-${key}-label]`);
    if (labelElement) labelElement.textContent = label;
    showAmount(Array.from(document.querySelectorAll<HTMLElement>(`[data-summary-${key}-price]`)), price, "");
  };

  const updateConfiguration = ({ syncUrl = true } = {}) => {
    const { bathrooms, additionalSos, membershipMonths } = readSelection();
    const purchase = getEyEagleConfiguredPurchase(bathrooms, additionalSos, membershipMonths);
    if (configurationError) configurationError.hidden = Boolean(purchase?.checkoutUrl);
    checkoutLinks.forEach((link) => {
      if (purchase?.checkoutUrl) {
        link.href = purchase.checkoutUrl;
        link.removeAttribute("aria-disabled");
      } else {
        link.removeAttribute("href");
        link.setAttribute("aria-disabled", "true");
      }
    });
    const gst = purchase ? estimateGstInr(purchase.totalInr) : 0;
    showAmount(totalPrices, purchase ? purchase.totalInr : null, "Unavailable");
    showAmount(totalGst, purchase ? gst : null, "—");
    showAmount(totalsWithGst, purchase ? purchase.totalInr + gst : null, "—");
    if (!purchase) return null;

    const extraBathrooms = bathrooms - EYEAGLE_SHOPIFY_CONFIG.bathroomMin;
    setSummaryRow("bathrooms", extraBathrooms, plural(extraBathrooms, "additional bathroom"), extraBathrooms * EYEAGLE_SHOPIFY_CONFIG.additionalBathroomPriceInr);
    setSummaryRow("sos", additionalSos, plural(additionalSos, "additional Alert Unit"), additionalSos * EYEAGLE_SHOPIFY_CONFIG.additionalSosPriceInr);

    // Paying monthly shows the monthly rate, which isn't part of this order's total.
    const plan = EYEAGLE_MEMBERSHIP_PLANS[purchase.membershipMonths];
    const monthly = purchase.membershipMonths === 0;
    const membershipLabel = document.querySelector<HTMLElement>("[data-summary-membership-label]");
    if (membershipLabel) membershipLabel.textContent = `Membership · ${plan.title}`;
    document.querySelector<HTMLElement>("[data-summary-membership-monthly]")?.toggleAttribute("hidden", !monthly);
    const membershipPrices = Array.from(document.querySelectorAll<HTMLElement>("[data-summary-membership-price]"));
    membershipPrices.forEach((element) => { element.dataset.suffix = monthly ? "/month + GST" : ""; });
    showAmount(membershipPrices, monthly ? EYEAGLE_SHOPIFY_CONFIG.membershipMonthlyInr : plan.priceInr, "");

    // Mirror the selection in the URL so a configuration can be shared or restored.
    if (!syncUrl) return purchase;
    const url = new URL(window.location.href);
    url.searchParams.set("bathrooms", String(bathrooms));
    url.searchParams.set("sos", String(additionalSos));
    url.searchParams.set("membership", String(purchase.membershipMonths));
    history.replaceState(null, "", url);
    return purchase;
  };

  // Restore a shared configuration, ignoring values the form doesn't offer.
  const params = new URLSearchParams(window.location.search);
  (["bathrooms", "sos", "membership"] as const).forEach((name) => {
    const value = params.get(name);
    const input = value === null ? null : form?.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`);
    if (input) input.checked = true;
  });

  form?.addEventListener("change", (event) => {
    updateConfiguration();
    const group = (event.target as HTMLElement).closest<HTMLElement>("[data-gallery-target]");
    if (group) showPanel(Number(group.dataset.galleryTarget));
  });
  form?.addEventListener("submit", (event) => event.preventDefault());
  checkoutLinks.forEach((link) => link.addEventListener("click", (event) => {
    if (!updateConfiguration()?.checkoutUrl) event.preventDefault();
  }));

  const shareButton = document.querySelector<HTMLButtonElement>("[data-share]");
  shareButton?.addEventListener("click", async () => {
    const url = window.location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: "EyEagle Home System", text: "The EyEagle setup I’m considering:", url });
        return;
      }
      await navigator.clipboard.writeText(url);
      shareButton.textContent = "Link copied";
      window.setTimeout(() => { shareButton.textContent = "Share this setup with family"; }, 2400);
    } catch {
      // Share sheet dismissed or clipboard unavailable; nothing to do.
    }
  });

  // On scroll: keep the price bar in view until the summary (which has its own checkout), and on desktop,
  // where the gallery is sticky, show the photo for the section being read, like Apple's buy pages.
  // A scroll check rather than IntersectionObserver: a fast fling can skip past a section without a crossing.
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-target]"));
  const stickyGallery = window.matchMedia("(min-width: 1024px)");
  let sectionPanel = -1;
  let frame = 0;
  const syncOnScroll = () => {
    frame = 0;
    if (bar && summarySection) bar.dataset.visible = String(summarySection.getBoundingClientRect().top > window.innerHeight * 0.8);
    if (!stickyGallery.matches || !sections.length) return;
    const readingLine = window.innerHeight * 0.45;
    const reading = sections.filter((section) => section.getBoundingClientRect().top <= readingLine).at(-1) ?? sections[0];
    const target = Number(reading.dataset.galleryTarget);
    // Only switch when the section changes, so arrows and dots still work within a section.
    if (target !== sectionPanel) {
      sectionPanel = target;
      showPanel(target);
    }
  };
  const requestSync = () => { if (!frame) frame = requestAnimationFrame(syncOnScroll); };
  window.addEventListener("scroll", requestSync, { passive: true });
  window.addEventListener("resize", requestSync);
  syncOnScroll();

  // Availability signup, shown while ordering is closed.
  const availabilityForm = document.querySelector<HTMLFormElement>("[data-availability-form]");
  const emailInput = availabilityForm?.querySelector<HTMLInputElement>('input[name="email"]');
  const submitButton = availabilityForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitButton?.querySelector<HTMLElement>("[data-submit-label]");
  const formStatus = availabilityForm?.querySelector<HTMLElement>("[data-form-status]");
  const setFormStatus = (message: string, isError = false) => {
    if (!formStatus || !emailInput) return;
    formStatus.setAttribute("role", isError ? "alert" : "status");
    formStatus.dataset.error = String(isError);
    formStatus.textContent = message;
    emailInput.setAttribute("aria-invalid", String(isError));
  };
  availabilityForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!emailInput || !submitButton || !submitLabel) return;
    const email = emailInput.value.trim();
    if (!emailInput.validity.valid || !email) {
      setFormStatus("Enter a valid email address.", true);
      emailInput.focus();
      return;
    }
    submitButton.disabled = true;
    submitLabel.textContent = "Saving…";
    setFormStatus("");
    try {
      const response = await fetch("/api/store-waitlist", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message || "We couldn’t add you to the list. Please try again.");
      availabilityForm.dataset.complete = "true";
      emailInput.disabled = true;
      submitLabel.textContent = "You’re on the list";
      setFormStatus("We’ll email you when EyEagle is available.");
    } catch (error) {
      submitButton.disabled = false;
      submitLabel.textContent = "Notify me";
      setFormStatus(error instanceof Error ? error.message : "We couldn’t add you to the list. Please try again.", true);
    }
  });

  updateConfiguration({ syncUrl: false });
</script>

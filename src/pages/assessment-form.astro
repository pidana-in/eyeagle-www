---
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import AssessmentFormUI from "../components/Assessment/AssessmentFormUI.astro";
import "../styles/home-v3-tokens.css";
import "../styles/AssessmentForm/page.css";

const metaTitle = "Home Safety Assessment | EyEagle";
const metaDesc =
  "EyEagle helps families reduce bathroom fall risks and get faster help during emergencies. Share your details and our team will contact you for a safety check or product explanation";
---

<MainLayout
  title={metaTitle}
  desc={metaDesc}
  bodyClass="eyeagle-home-v3 assessment-page"
>
  <AssessmentFormUI />
</MainLayout>

<script is:inline>
  const dropdownButton = document.getElementById("dropdownButton");

  const dropdownMenu = document.getElementById("dropdownMenu");

  const fullNameField = document.getElementById("fullNameField");

  const fullNameError = document.getElementById("fullNameError");

  const phCode = document.getElementById("phCode");

  const phoneNumField = document.getElementById("phoneNumField");

  const submitButton = document.getElementById("submitButton");

  const buttonText = document.getElementById("buttonText");

  const loader = document.getElementById("loader");

  const consideringForError = document.getElementById("consideringForError");

  const safetyConcernError = document.getElementById("safetyConcernError");

  const siteLocationField = document.getElementById("siteLocation");

  const concernDescriptionField = document.getElementById("concernDescription");

  const iconSpan = document.getElementById("countryIcon");

  /*
   * COUNTRY DROPDOWN
   */

  dropdownButton.addEventListener("click", () => {
    dropdownMenu.classList.toggle("hidden");

    dropdownButton.setAttribute(
      "aria-expanded",
      String(!dropdownMenu.classList.contains("hidden")),
    );

    if (!dropdownMenu.classList.contains("hidden")) {
      dropdownMenu
        .querySelector(".bg-gray-300")
        ?.scrollIntoView({ block: "nearest" });
    }
  });

  dropdownMenu.addEventListener("click", (event) => {
    const option =
      event.target instanceof Element
        ? event.target.closest("button[data-value][data-country-code]")
        : null;

    if (!(option instanceof HTMLButtonElement)) {
      return;
    }

    const selectedDialCode = option.dataset.value;

    const selectedCountryCode = option.dataset.countryCode;

    if (!selectedDialCode || !selectedCountryCode) {
      return;
    }

    dropdownButton.innerHTML = "";

    const flagImage = document.createElement("img");

    flagImage.src = `https://flagcdn.com/w40/${selectedCountryCode.toLowerCase()}.png`;

    flagImage.alt = `${selectedCountryCode} flag`;

    flagImage.width = 20;

    flagImage.className = "mr-2";

    dropdownButton.appendChild(flagImage);

    dropdownButton.appendChild(document.createTextNode(selectedDialCode));

    dropdownButton.appendChild(iconSpan);

    phCode.value = selectedDialCode;

    dropdownMenu.classList.add("hidden");

    dropdownButton.setAttribute("aria-expanded", "false");

    document
      .querySelectorAll("#dropdownMenu > button[data-value]")
      .forEach((el) => el.classList.remove("bg-gray-300"));

    option.classList.add("bg-gray-300");
  });

  /*
   * CLOSE DROPDOWN OUTSIDE CLICK
   */

  document.addEventListener("click", (event) => {
    if (
      !dropdownButton.contains(event.target) &&
      !dropdownMenu.contains(event.target)
    ) {
      dropdownMenu.classList.add("hidden");

      dropdownButton.setAttribute("aria-expanded", "false");
    }
  });

  /*
   * DEFAULT INDIA CODE
   */

  function initializeDefaultPhoneCode() {
    const defaultDialCode = "+91";

    const defaultOption = Array.from(
      dropdownMenu.querySelectorAll("button[data-value][data-country-code]"),
    ).find((option) => option.dataset.value === defaultDialCode);

    if (defaultOption instanceof HTMLButtonElement) {
      const defaultCountryCode = defaultOption.dataset.countryCode;

      if (!defaultCountryCode) {
        return;
      }

      const flagImage = document.createElement("img");

      flagImage.src = `https://flagcdn.com/w40/${defaultCountryCode.toLowerCase()}.png`;

      flagImage.alt = `${defaultCountryCode} flag`;

      flagImage.width = 20;

      flagImage.className = "mr-2";

      dropdownButton.innerHTML = "";

      dropdownButton.appendChild(flagImage);

      dropdownButton.appendChild(document.createTextNode(defaultDialCode));

      dropdownButton.appendChild(iconSpan);

      phCode.value = defaultDialCode;

      defaultOption.classList.add("bg-gray-300");
    }
  }

  initializeDefaultPhoneCode();

  /*
   * FORM VALIDATION + CRM API SUBMISSION
   */

  const phoneError = document.getElementById("phoneError");

  const assessmentFormEl = document.getElementById("assessmentForm");

  const assessmentFormWrapper = document.getElementById(
    "assessmentFormWrapper",
  );

  const submitErrorBanner = document.getElementById("submitErrorBanner");

  const successMessageBlock = document.getElementById(
    "assessmentSuccessMessage",
  );

  const successMessageText = document.getElementById("assessmentSuccessText");

  const consentField = document.getElementById("consent");

  /*
   * CLIENT SUBMISSION ID
   *
   * Generated once per "attempt" and reused across retries/double
   * clicks so the backend can dedupe on its side. Persisted in
   * sessionStorage so it survives a manual page refresh mid-retry.
   * Only cleared after a confirmed SUCCESS response.
   */

  const SUBMISSION_ID_KEY = "eyeagle_assessment_submission_id";

  function getOrCreateClientSubmissionId() {
    let id = sessionStorage.getItem(SUBMISSION_ID_KEY);

    if (!id) {
      id = crypto.randomUUID();

      sessionStorage.setItem(SUBMISSION_ID_KEY, id);
    }

    return id;
  }

  function clearClientSubmissionId() {
    sessionStorage.removeItem(SUBMISSION_ID_KEY);
  }

  function showSubmitError(message) {
    submitErrorBanner.textContent = message;

    submitErrorBanner.classList.remove("hidden");

    submitErrorBanner.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  function hideSubmitError() {
    submitErrorBanner.classList.add("hidden");

    submitErrorBanner.textContent = "";
  }

  function setSubmitting(isSubmitting) {
    buttonText.classList.toggle("opacity-0", isSubmitting);

    loader.classList.toggle("hidden", !isSubmitting);

    submitButton.disabled = isSubmitting;
  }

  /*
   * Fire-and-forget request that triggers the SMTP notification email
   * on the server. Not awaited by the main submit flow — its result
   * has no effect on the success/error UI shown to the user.
   */

  function notifyByEmail() {
    try {
      fetch(window.location.pathname, {
        method: "POST",
        headers: {
          "X-Requested-With": "fetch",
        },
        body: new FormData(assessmentFormEl),
      }).catch(() => {});
    } catch (err) {
      // Non-critical — swallow, the CRM submission is what matters.
    }
  }

  assessmentFormEl.addEventListener("submit", async function (e) {
    e.preventDefault();

    const phoneValue = phoneNumField.value.trim();

    const phoneRegex = /^[6-9]\d{9}$/;

    const fullNameValue = fullNameField.value.trim();

    const nameRegex = /^[A-Za-z\s]{2,}$/;

    /*
     * RESET ERRORS
     */

    phoneError.classList.add("hidden");

    fullNameError.classList.add("hidden");

    consideringForError.classList.add("hidden");

    safetyConcernError.classList.add("hidden");

    phoneNumField.classList.remove("border-red-500");

    fullNameField.classList.remove("border-red-500");

    hideSubmitError();

    /*
     * FULL NAME VALIDATION
     */

    if (!nameRegex.test(fullNameValue)) {
      fullNameError.classList.remove("hidden");

      fullNameField.classList.add("border-red-500");

      fullNameField.focus();

      return;
    }

    /*
     * PHONE VALIDATION
     */

    if (!phoneRegex.test(phoneValue)) {
      phoneError.classList.remove("hidden");

      phoneNumField.classList.add("border-red-500");

      phoneNumField.focus();

      return;
    }

    /*
     * CONSIDERING FOR VALIDATION
     */

    const consideringForChecked = Array.from(
      document.querySelectorAll('input[name="consideringFor"]:checked'),
    ).map((el) => el.value);

    if (consideringForChecked.length === 0) {
      consideringForError.classList.remove("hidden");

      consideringForError.scrollIntoView({
        behavior: "smooth",
        block: "center",
      });

      return;
    }

    /*
     * SAFETY CONCERN VALIDATION
     */

    const safetyConcernsChecked = Array.from(
      document.querySelectorAll('input[name="safetyConcerns"]:checked'),
    ).map((el) => el.value);

    if (safetyConcernsChecked.length === 0) {
      safetyConcernError.classList.remove("hidden");

      safetyConcernError.scrollIntoView({
        behavior: "smooth",
        block: "center",
      });

      return;
    }

    /*
     * BUILD CRM API PAYLOAD
     */

    const immediateConcernField = document.querySelector(
      'input[name="immediateSafetyConcern"]:checked',
    );

    const whatNextField = document.querySelector(
      'input[name="whatNext"]:checked',
    );

    const preferredDayField = document.querySelector(
      'input[name="preferredContactDay"]:checked',
    );

    const preferredTimingField = document.querySelector(
      'input[name="preferredContactTime"]:checked',
    );

    const clientSubmissionId = getOrCreateClientSubmissionId();

    const payload = {
      clientSubmissionId,
      name: fullNameValue,
      phone: `${phCode.value} ${phoneValue}`,
      location: siteLocationField ? siteLocationField.value.trim() : "",
      consideringFor: consideringForChecked,
      mainConcerns: safetyConcernsChecked,
      immediateConcern: immediateConcernField
        ? immediateConcernField.value
        : "",
      description: concernDescriptionField
        ? concernDescriptionField.value.trim()
        : "",
      interestedIn: whatNextField ? whatNextField.value : "",
      preferredDay: preferredDayField ? preferredDayField.value : "",
      preferredTiming: preferredTimingField ? preferredTimingField.value : "",
      contactConsent: consentField ? consentField.checked : false,
    };

    setSubmitting(true);

    // Fire the SMTP notification in parallel — not awaited.
    notifyByEmail();

    try {
      const response = await fetch("/api/assessment-submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (data?.status?.toLowerCase() === "success") {
        // SUCCESS
        successMessageText.textContent =
          data?.result ||
          data?.data ||
          "Thank you for your interest in EyEagle. Your form has been submitted successfully, and our team will contact you shortly.";

        assessmentFormWrapper.classList.add("hidden");
        successMessageBlock.classList.remove("hidden");

        // Clear form and submission ID ONLY after successful submission
        assessmentFormEl.reset();
        clearClientSubmissionId();
      } else {
        // BACKEND FAILURE
        const errorMessage =
          data?.error?.message ||
          data?.error?.title ||
          "Something went wrong while submitting the form. Please try again.";

        showSubmitError(errorMessage);
      }
    } catch (err) {
      console.error("Error while submitting assessment form:", err);

      showSubmitError(
        "Something went wrong while submitting the form. Please try again.",
      );
    } finally {
      setSubmitting(false);
    }
  });

  /*
   * CLEAR NAME ERROR
   */

  fullNameField.addEventListener("input", () => {
    fullNameError.classList.add("hidden");

    fullNameField.classList.remove("border-red-500");
  });

  /*
   * CLEAR PHONE ERROR
   */

  phoneNumField.addEventListener("input", () => {
    phoneError.classList.add("hidden");

    phoneNumField.classList.remove("border-red-500");
  });

  /*
   * ONLY NUMBERS IN PHONE
   */

  phoneNumField.addEventListener("input", () => {
    phoneNumField.value = phoneNumField.value.replace(/\D/g, "");
  });
</script>

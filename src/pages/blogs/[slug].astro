---
export const prerender = true;

import { blogTopic } from "../../utils/blog-topic";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import Image from "../../components/common/OptimizedImage.astro";
import MaterialIcon from "../../components/common/MaterialIcon.astro";
import SiteHeader from "../../components/HomeV3/SiteHeader.astro";
import SiteFooter from "../../components/HomeV3/SiteFooter.astro";
import styles from "../../styles/Blog/article.module.css";
import "../../styles/home-v3-tokens.css";
import "../../styles/blog-editorial.css";
import { blogsData } from "../../components/constants/home";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs");
  return blogs.flatMap((blog) => {
    const publicSlug = blog.data.slug ?? blog.id;
    const slugs = publicSlug === blog.id ? [publicSlug] : [publicSlug, blog.id];
    return slugs.map((slug) => ({ params: { slug } }));
  });
}

const { slug } = Astro.params;
const blogs = await getCollection("blogs");
const blog = blogs.find((entry) => (entry.data.slug ?? entry.id) === slug || entry.id === slug);
if (!blog) throw new Error("Blog not found");

const { Content } = await render(blog);
const blogMeta = blogsData.find((item) => item.slug === blog.data.slug);
const displayTitle = (title: string) => title.replace(/\s*\|\s*EyEagle\s*$/i, "");
const metaTitle = blog.data.title;
const metaDesc = blog.data.desc ?? blogMeta?.desc ?? "Read the latest article on EyEagle's journal.";
const site = (Astro.site?.toString() || "https://eyeagle.ai").replace(/\/+$/, "");
const socialImage = await getImage({ src: blog.data.img, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 });
const metaImage = `${site}${socialImage.src}`;
const relatedBlogs = blogs
  .filter((entry) => entry.id !== blog.id)
  .sort((a, b) => Number(blogTopic(b.data.title) === blogTopic(blog.data.title)) - Number(blogTopic(a.data.title) === blogTopic(blog.data.title)) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const publicSlug = blog.data.slug ?? blog.id;
const blogUrl = `${site}/blogs/${publicSlug}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(blogUrl)}`;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(blogUrl)}`;
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(blogUrl)}&text=${encodeURIComponent(blog.data.title)}`;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-IN", { day: "numeric", month: "long", year: "numeric" }).format(date);
const articleHref = (entry: CollectionEntry<"blogs">) => `/blogs/${entry.data.slug ?? entry.id}`;
---

<MainLayout
  title={metaTitle}
  desc={metaDesc}
  canonicalPath={`/blogs/${publicSlug}`}
  metaImage={metaImage}
  metaImageAlt={blog.data.title}
  metaImageWidth={1200}
  metaImageHeight={630}
  article={{ headline: blog.data.title, author: blog.data.author, datePublished: blog.data.date.toISOString(), image: metaImage }}
  showChrome={false}
  bodyClass="eyeagle-home-v3 eyeagle-blog"
>
  <SiteHeader slot="header" solidAtTop />

  <main class={styles.main} id="main-content">
    <header class={styles.articleHero}>
      <div class={styles.heroInner}>
        <div class={styles.breadcrumb}><a href="/blog">EyEagle Journal</a><span aria-hidden="true">/</span><span>{blogTopic(blog.data.title)}</span></div>
        <h1>{displayTitle(blog.data.title)}</h1>
        {metaDesc && <p class={styles.deck}>{metaDesc}</p>}
        <div class={styles.byline}>
          <div><span>Written by</span><strong>{blog.data.author}</strong></div>
          <div><span>{blog.data.authorRole}</span><time datetime={blog.data.date.toISOString()}>{formatDate(blog.data.date)}</time></div>
        </div>
      </div>
      <div class={styles.heroMedia}><Image src={blog.data.img} alt={blog.data.title} class={styles.fillImage} loading="eager" fetchpriority="high" layout="full-width" quality={86} /></div>
    </header>

    <div class={styles.mobileTools}>
      <details>
        <summary>In this article <span aria-hidden="true">+</span></summary>
        <nav id="toc-mobile" aria-label="Article contents"></nav>
      </details>
    </div>

    <article class={styles.articleShell}>
      <aside class={styles.sidebar}>
        <div class={styles.sidebarInner}>
          <p class={styles.sideLabel}>In this article</p>
          <nav id="toc" aria-label="Article contents"></nav>
          <div class={styles.share}>
            <p class={styles.sideLabel}>Share</p>
            <a href={xShare} target="_blank" rel="noopener noreferrer">X</a>
            <a href={facebookShare} target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href={linkedinShare} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>
      </aside>
      <div id="blog-content" class={styles.articleContent}><Content /></div>
    </article>

    <section class={styles.related} aria-labelledby="related-title">
      <div class={styles.relatedHeading}><h2 id="related-title">Continue reading</h2><a href="/blog">View all articles</a></div>
      <div class={styles.relatedGrid}>
        {relatedBlogs.map((item) => (
          <article class={styles.relatedStory}>
            <a href={articleHref(item)}>
              <div class={styles.relatedMedia}><Image src={item.data.img} alt={item.data.title} class={styles.fillImage} layout="full-width" /></div>
              <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
              <h3>{displayTitle(item.data.title)}</h3>
              <MaterialIcon name="arrow_outward" classNames={styles.relatedArrow} />
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter slot="footer" />
</MainLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const article = document.getElementById("blog-content");
    const tocDesktop = document.getElementById("toc");
    const tocMobile = document.getElementById("toc-mobile");
    if (!article) return;

    const headings = article.querySelectorAll("h2");
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `heading-${index + 1}`;
      [tocDesktop, tocMobile].forEach((toc) => {
        if (!toc) return;
        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        toc.appendChild(link);
      });
    });

    const faqHeading = Array.from(article.querySelectorAll("h2")).find((heading) => heading.textContent?.trim().toLowerCase() === "faq");
    if (!faqHeading) return;
    const faqQuestions = [];
    let currentElement = faqHeading.nextElementSibling;
    while (currentElement && currentElement.tagName !== "H2") {
      if (currentElement.tagName === "H3") faqQuestions.push(currentElement);
      currentElement = currentElement.nextElementSibling;
    }

    faqQuestions.forEach((question) => {
      const accordion = document.createElement("div");
      accordion.className = "faq-accordion";
      const button = document.createElement("button");
      button.type = "button";
      button.className = "faq-question";
      button.setAttribute("aria-expanded", "false");
      const questionText = document.createElement("span");
      questionText.textContent = question.textContent;
      const icon = document.createElement("span");
      icon.className = "faq-icon";
      icon.setAttribute("aria-hidden", "true");
      button.append(questionText, icon);
      const answer = document.createElement("div");
      answer.className = "faq-answer";
      question.parentNode.insertBefore(accordion, question);
      accordion.append(button, answer);
      let nextElement = question.nextElementSibling;
      while (nextElement && nextElement.tagName !== "H3" && nextElement.tagName !== "H2") {
        const elementToMove = nextElement;
        nextElement = nextElement.nextElementSibling;
        answer.appendChild(elementToMove);
      }
      question.remove();
      button.addEventListener("click", () => {
        const isOpen = accordion.classList.contains("active");
        article.querySelectorAll(".faq-accordion.active").forEach((item) => {
          if (item === accordion) return;
          item.classList.remove("active");
          item.querySelector(".faq-question")?.setAttribute("aria-expanded", "false");
        });
        accordion.classList.toggle("active", !isOpen);
        button.setAttribute("aria-expanded", String(!isOpen));
      });
    });
  });
</script>

---
import MainLayout from "../layouts/MainLayout.astro";
import Image from "../components/common/OptimizedImage.astro";
import SiteHeader from "../components/HomeV3/SiteHeader.astro";
import OrderItemImage from "../assets/Orders/OrderItemImage.png";
import styles from "../styles/Orders/page.module.css";
import "../styles/home-v3-tokens.css";
import "../styles/home-v4-tokens.css";

const journey = [
  { label: "Order placed", detail: "12 October 2024", state: "complete" },
  { label: "Installation address", detail: "Required to schedule your visit", state: "current" },
  { label: "System prepared", detail: "Configured and dispatched after confirmation", state: "upcoming" },
  { label: "Installed and ready", detail: "Installed, tested and connected to your Nest", state: "upcoming" },
] as const;
---

<MainLayout title="Your EyEagle order" desc="Review your EyEagle order and complete the next step in your installation." noindex={true} showChrome={false} bodyClass="eyeagle-home-v3 eyeagle-home-v4">
  <SiteHeader slot="header" solidAtTop />
  <main class={styles.main} id="main-content">
    <header class={styles.intro}>
      <div>
        <p class={styles.eyebrow}>Order EY-10482</p>
        <h1>Your EyEagle installation.</h1>
      </div>
      <p>Complete the address to move your system into preparation and schedule installation.</p>
    </header>

    <section class={styles.workspace} aria-label="Open order">
      <div class={styles.orderPane}>
        <div class={styles.statusLine}>
          <span aria-hidden="true"></span>
          <p><strong>Action required</strong> · Waiting for installation address</p>
        </div>

        <article class={styles.orderItem}>
          <div class={styles.productMedia}>
            <Image src={OrderItemImage} alt="EyEagle Complete Home System" class={styles.productImage} loading="eager" fetchpriority="high" quality={90} />
          </div>
          <div class={styles.productCopy}>
            <p>EyEagle membership</p>
            <h2>Complete Home System</h2>
            <dl>
              <div><dt>Home setup</dt><dd>1 bathroom · 1 SOS button</dd></div>
              <div><dt>Membership</dt><dd>3 years included</dd></div>
              <div><dt>Order total</dt><dd>$799</dd></div>
            </dl>
          </div>
        </article>

        <div class={styles.nextAction}>
          <div>
            <p>Next step</p>
            <h2>Where should we install EyEagle?</h2>
            <span>Add your parent’s address and a local contact so our team can prepare the installation.</span>
          </div>
          <a href="/contact?source=order">Add installation address <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class={styles.journeyPane} aria-labelledby="journey-title">
        <p class={styles.eyebrow}>What happens next</p>
        <h2 id="journey-title">From order to a ready home.</h2>
        <ol class={styles.journey}>
          {journey.map((step, index) => (
            <li data-state={step.state}>
              <span class={styles.marker}>{step.state === "complete" ? "✓" : String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step.label}</h3><p>{step.detail}</p></div>
            </li>
          ))}
        </ol>
        <div class={styles.help}>
          <p>Need help with this order?</p>
          <a href="/contact">Talk to the EyEagle team <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </section>
  </main>
</MainLayout>

---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSection from "../components/Protection/HeroSection.astro";
import KitSection from "../components/Protection/KitSection.astro";
import WhereWeInstall from "../components/Protection/WhereWeInstall.astro";
import DesignedFor from "../components/Protection/DesignedFor.astro";
import Benefits from "../components/Protection/Benefits.astro";
import Installation from "../components/Protection/Installation.astro";
import Comparison from "../components/Protection/Comparison.astro";
import {
  featurePoints,
  heroContent,
  overviewCards,
  barFeatures,
  matFeatures,
  tapeFeatures,
  sectionHeaders,
  kitData,
  zones,
  installData,
  statsData,
  userCards,
  cardsData,
  installSteps,
  installFeatures,
  installCards,
  installImages,
  comparisonData,
  comparisonRows,
  comparisonColumns,
  faqsData,
} from "../components/constants/protection";
import CTA from "../components/NewHome/CTA.astro";
import { ctaSection } from "../components/constants/newHome";
import FAQs from "../components/Protection/FAQs.astro";
import "../styles/home-v3-tokens.css";
import "../styles/Protection/page.css";

const metaTitle = "Bathroom Fall-Prevention and Safety Products | EyEagle";
const metaDesc =
  "Make bathrooms safer with professionally installed grab bars, anti-slip mats, grip tape, and a home safety assessment from EyEagle.";

const protectionCtaSection = {
  ...ctaSection,
  eyebrow: "Bathroom protection, planned for your home",
  title: "Start with a bathroom safety assessment.",
  description:
    "Tell us who uses the space and which movements feel difficult. We’ll assess the toilet, wet zone and entry path, then recommend the right supports for your bathroom.",
  primaryCta: {
    label: "Get a bathroom assessment",
    href: "/assessment-form",
  },
  secondaryCta: {
    label: "Talk to our team",
    href: "/contact",
  },
};
---

<MainLayout
  title={metaTitle}
  desc={metaDesc}
  bodyClass="eyeagle-home-v3 protection-page"
  mainClass="legacy-content"
  headerActionHref="/assessment-form"
  headerActionLabel="Get assessment"
>
  <HeroSection featurePoints={featurePoints} heroContent={heroContent} />
  <KitSection
    overviewCards={overviewCards}
    barFeatures={barFeatures}
    matFeatures={matFeatures}
    tapeFeatures={tapeFeatures}
    sectionHeaders={sectionHeaders}
    kitData={kitData}
  />
  <WhereWeInstall zones={zones} installData={installData} />
  <DesignedFor userCards={userCards} statsData={statsData} />
  <Benefits cardsData={cardsData} />
  <Installation
    installSteps={installSteps}
    installCards={installCards}
    installFeatures={installFeatures}
    installImages={installImages}
  />
  <Comparison
    comparisonData={comparisonData}
    comparisonRows={comparisonRows}
    comparisonColumns={comparisonColumns}
  />
  <FAQs faqsData={faqsData} />
  <CTA ctaSection={protectionCtaSection} />
</MainLayout>
